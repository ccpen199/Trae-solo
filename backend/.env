# 后端服务配置
PORT=18763
HOST=0.0.0.0
NODE_ENV=development

# 数据库配置 - PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/community_db

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# JWT 配置
JWT_SECRET=community-forum-jwt-secret-key-2024-production
JWT_EXPIRES_IN=7d

# CORS 配置 - 允许的前端地址
CORS_ORIGINS=http://localhost:28763,http://127.0.0.1:28763

# 智能审核配置
AUTO_MOD_ENABLED=true
AUTO_MOD_SENSITIVITY=0.7

# 限流配置
RATE_LIMIT_MAX=100

# 声望系统配置
REPUTATION_POST_REWARD=10
REPUTATION_COMMENT_REWARD=2
REPUTATION_LIKE_RECEIVED_REWARD=1
MODERATOR_UNLOCK_LEVEL=10
