# 后端服务端口（稀有端口：8472）
PORT=8472

# 数据库配置
DATABASE_URL="postgresql://dist_admin:DistPass2024@localhost:5432/dist_commission?schema=public"

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT配置
JWT_SECRET=dist-commission-jwt-secret-key-2024-very-secure
JWT_EXPIRES_IN=7d

# 分销配置
# 分销层级深度
DISTRIBUTION_MAX_LEVEL=3
# 售后期（天）
AFTER_SALE_DAYS=7

# 提现配置
# 最小提现金额（分）
MIN_WITHDRAW_AMOUNT=100
# 最大提现金额（分）
MAX_WITHDRAW_AMOUNT=500000

# 反作弊配置
# 同一IP注册上限
MAX_REGISTER_PER_IP=5
# 同一设备注册上限
MAX_REGISTER_PER_DEVICE=3
# 下单时间间隔阈值（秒）- 过短可能刷单
ORDER_MIN_INTERVAL_SECONDS=60
