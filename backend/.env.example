# ================================================
# 会员积分系统 - 环境配置模板
# 说明：复制此文件为 .env 并根据实际情况修改
# ================================================

# 服务端口配置（稀有端口：9876，避免与常见端口冲突）
# 可通过环境变量 PORT 覆盖此配置
PORT=9876

# 前端端口配置（用于 CORS 白名单）
FRONTEND_PORT=9877

# ================================================
# 数据库配置（SQLite 轻量级，无需额外安装）
# ================================================
DB_TYPE=sqlite
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=admin
DB_PASSWORD=Points@2024
DB_DATABASE=membership_points
DB_SYNCHRONIZE=true
DB_LOGGING=false

# ================================================
# JWT 配置
# ================================================
JWT_SECRET=YourJWTSecretKeyHerePleaseMakeItLongAndSecure
JWT_EXPIRES_IN=7d

# ================================================
# 日志配置
# ================================================
LOG_LEVEL=info

# ================================================
# 效期管理配置
# ================================================
# 积分默认有效期（天数）
DEFAULT_POINTS_EXPIRY_DAYS=365
# 临期提醒天数（提前多少天提醒）
EXPIRY_NOTIFICATION_DAYS=7

# ================================================
# 兑换配置
# ================================================
# 积分冻结超时时间（毫秒），默认30分钟
EXCHANGE_FREEZE_TIMEOUT=1800000
