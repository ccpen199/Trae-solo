generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  JOBSEEKER
  HR
  SCHOOL
  REGULATOR
}

enum MatchStatus {
  PENDING
  MATCHED
  INTERESTED
  NOT_INTERESTED
  INTERVIEW_SCHEDULED
  OFFER_SENT
  HIRED
  REJECTED
}

enum InterviewStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum AuditStatus {
  PENDING
  APPROVED
  REJECTED
  UNDER_REVIEW
}

enum EducationLevel {
  HIGH_SCHOOL
  COLLEGE
  BACHELOR
  MASTER
  DOCTOR
  OTHER
}

enum ExperienceLevel {
  FRESHER
  ONE_TO_THREE
  THREE_TO_FIVE
  FIVE_TO_TEN
  TEN_PLUS
}

model User {
  id            Int      @id @default(autoincrement())
  username      String   @unique
  email         String   @unique
  password      String
  role          UserRole
  phone         String?
  avatar        String?
  realName      String?
  idCard        String?
  isVerified    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())

  jobseekerProfile JobseekerProfile?
  hrProfile        HRProfile?
  schoolProfile    SchoolProfile?
  regulatorProfile RegulatorProfile?
  auditRecords     AuditRecord[]
  createdJobs      Job[]            @relation("JobCreator")
}

model City {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String   @unique
  province  String   @default("山东省")
  latitude  Float?
  longitude Float?
  jobs      Job[]
  jobseekers JobseekerProfile[]
}

model Industry {
  id    Int    @id @default(autoincrement())
  name  String @unique
  code  String @unique
  jobs  Job[]
  jobseekers JobseekerProfile[]
}

model Skill {
  id   Int    @id @default(autoincrement())
  name String @unique
  jobs JobSkill[]
  resumes ResumeSkill[]
}

model JobseekerProfile {
  id              Int              @id @default(autoincrement())
  userId          Int              @unique
  user            User             @relation(fields: [userId], references: [id])
  cityId          Int?
  city            City?            @relation(fields: [cityId], references: [id])
  industryId      Int?
  industry        Industry?        @relation(fields: [industryId], references: [id])
  gender          String?
  birthDate       DateTime?
  educationLevel  EducationLevel?
  experienceLevel ExperienceLevel?
  expectedSalary  Int?
  currentSalary   Int?
  workYears       Float?
  latitude        Float?
  longitude       Float?
  address         String?
  selfIntroduction String?
  jobIntention    String?
  isLookingForJob Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now())

  resumes         Resume[]
  matches         JobMatch[]       @relation("JobseekerMatches")
  interviews      Interview[]      @relation("JobseekerInterviews")
  offers          JobOffer[]
}

model Resume {
  id              Int              @id @default(autoincrement())
  jobseekerId     Int
  jobseeker       JobseekerProfile @relation(fields: [jobseekerId], references: [id])
  title           String
  content         String
  education       Json?
  workExperience  Json?
  projectExperience Json?
  skills          ResumeSkill[]
  ocrData         Json?
  isOcrCompleted  Boolean          @default(false)
  isDefault       Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now())

  matches         JobMatch[]
}

model ResumeSkill {
  id        Int    @id @default(autoincrement())
  resumeId  Int
  resume    Resume @relation(fields: [resumeId], references: [id])
  skillId   Int
  skill     Skill  @relation(fields: [skillId], references: [id])
  proficiency Int?
  years     Float?
}

model Company {
  id              Int      @id @default(autoincrement())
  name            String   @unique
  unifiedSocialCode String?
  legalPerson     String?
  registeredCapital String?
  establishmentDate DateTime?
  industryId      Int?
  industry        Industry? @relation(fields: [industryId], references: [id])
  cityId          Int?
  city            City?     @relation(fields: [cityId], references: [id])
  address         String?
  latitude        Float?
  longitude       Float?
  businessScope   String?
  companyType     String?
  employeeCount   String?
  logo            String?
  description     String?
  website         String?
  contactPhone    String?
  contactEmail    String?
  auditStatus     AuditStatus @default(PENDING)
  auditReason     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now())

  hrs             HRProfile[]
  jobs            Job[]
  auditRecords    AuditRecord[]
}

model HRProfile {
  id           Int       @id @default(autoincrement())
  userId       Int       @unique
  user         User      @relation(fields: [userId], references: [id])
  companyId    Int?
  company      Company?  @relation(fields: [companyId], references: [id])
  department   String?
  position     String?
  workPhone    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now())
}

model School {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  code          String?
  schoolType    String?
  cityId        Int?
  city          City?    @relation(fields: [cityId], references: [id])
  address       String?
  contactPerson String?
  contactPhone  String?
  website       String?
  description   String?
  auditStatus   AuditStatus @default(PENDING)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())

  profiles      SchoolProfile[]
  auditRecords  AuditRecord[]
}

model SchoolProfile {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique
  user       User     @relation(fields: [userId], references: [id])
  schoolId   Int?
  school     School?  @relation(fields: [schoolId], references: [id])
  department String?
  position   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())
}

model RegulatorProfile {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  user        User     @relation(fields: [userId], references: [id])
  department  String?
  position    String?
  region      String?
  permissions Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  supervisionRecords SupervisionRecord[]
}

model Job {
  id              Int              @id @default(autoincrement())
  title           String
  companyId       Int
  company         Company          @relation(fields: [companyId], references: [id])
  creatorId       Int
  creator         User             @relation("JobCreator", fields: [creatorId], references: [id])
  cityId          Int
  city            City             @relation(fields: [cityId], references: [id])
  industryId      Int
  industry        Industry         @relation(fields: [industryId], references: [id])
  jobType         String?
  salaryMin       Int
  salaryMax       Int
  educationLevel  EducationLevel?
  experienceLevel ExperienceLevel?
  description     String
  requirements    String?
  benefits        String?
  workAddress     String?
  latitude        Float?
  longitude       Float?
  recruitCount    Int              @default(1)
  isRemote        Boolean          @default(false)
  isUrgent        Boolean          @default(false)
  auditStatus     AuditStatus      @default(PENDING)
  auditReason     String?
  status          String           @default("ACTIVE")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now())
  expiresAt       DateTime?

  skills          JobSkill[]
  matches         JobMatch[]       @relation("JobMatches")
  interviews      Interview[]      @relation("JobInterviews")
  offers          JobOffer[]
  auditRecords    AuditRecord[]
}

model JobSkill {
  id      Int   @id @default(autoincrement())
  jobId   Int
  job     Job   @relation(fields: [jobId], references: [id])
  skillId Int
  skill   Skill @relation(fields: [skillId], references: [id])
  isRequired Boolean @default(true)
  priority   Int?
}

model JobMatch {
  id              Int              @id @default(autoincrement())
  jobId           Int
  job             Job              @relation("JobMatches", fields: [jobId], references: [id])
  jobseekerId     Int
  jobseeker       JobseekerProfile @relation("JobseekerMatches", fields: [jobseekerId], references: [id])
  resumeId        Int?
  resume          Resume?          @relation(fields: [resumeId], references: [id])
  status          MatchStatus      @default(PENDING)
  matchScore      Float?
  matchReason     String?
  distanceKm      Float?
  skillMatchCount Int?
  salaryMatch     String?
  hrRemark        String?
  jobseekerRemark String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now())

  interviews      Interview[]
  offers          JobOffer[]
}

model Interview {
  id              Int              @id @default(autoincrement())
  matchId         Int
  match           JobMatch         @relation(fields: [matchId], references: [id])
  jobId           Int
  job             Job              @relation("JobInterviews", fields: [jobId], references: [id])
  jobseekerId     Int
  jobseeker       JobseekerProfile @relation("JobseekerInterviews", fields: [jobseekerId], references: [id])
  interviewerId   Int?
  interviewer     User?            @relation(fields: [interviewerId], references: [id])
  status          InterviewStatus  @default(SCHEDULED)
  interviewType   String?
  scheduledAt     DateTime
  durationMinutes Int              @default(60)
  location        String?
  meetingLink     String?
  hrNotes         String?
  candidateNotes  String?
  feedback        String?
  rating          Int?
  result          String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now())
}

model JobOffer {
  id          Int      @id @default(autoincrement())
  matchId     Int
  match       JobMatch @relation(fields: [matchId], references: [id])
  jobId       Int
  job         Job      @relation(fields: [jobId], references: [id])
  jobseekerId Int
  jobseeker   JobseekerProfile @relation(fields: [jobseekerId], references: [id])
  salary      Int
  benefits    String?
  startDate   DateTime?
  deadline    DateTime
  status      String   @default("PENDING")
  hrRemark    String?
  candidateRemark String?
  acceptedAt  DateTime?
  rejectedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
}

model AuditRecord {
  id         Int         @id @default(autoincrement())
  auditorId  Int?
  auditor    User?       @relation(fields: [auditorId], references: [id])
  targetType String
  targetId   Int
  status     AuditStatus @default(PENDING)
  reason     String?
  remark     String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @default(now())
}

model SupervisionRecord {
  id           Int      @id @default(autoincrement())
  regulatorId  Int
  regulator    RegulatorProfile @relation(fields: [regulatorId], references: [id])
  targetType   String
  targetId     Int
  checkType    String
  checkResult  String
  issuesFound  String?
  rectificationRequired String?
  rectificationDeadline DateTime?
  status       String   @default("PENDING")
  remark       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())
}

model HeatMapData {
  id        Int      @id @default(autoincrement())
  cityId    Int
  city      City     @relation(fields: [cityId], references: [id])
  industryId Int?
  industry  Industry? @relation(fields: [industryId], references: [id])
  dataType  String
  count     Int
  period    String
  createdAt DateTime @default(now())

  @@unique([cityId, industryId, dataType, period])
}
