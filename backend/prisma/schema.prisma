generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  RECEPTIONIST
  TECHNICIAN
  MANAGER
}

enum AppointmentStatus {
  PENDING
  BOOKED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  PAID
  PENDING_REVIEW
  REVIEWED
  CANCELLED
  NO_SHOW
}

enum TechnicianStatus {
  AVAILABLE
  BUSY
  ON_LEAVE
  OFF_WORK
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  RESERVED
}

enum OrderStatus {
  PENDING
  PARTIAL_PAID
  PAID
  REFUNDED
  CANCELLED
}

enum InventoryActionType {
  ADD
  DEDUCT
  ADJUST
  RETURN
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  password     String
  realName     String?
  phone        String   @unique
  email        String?  @unique
  role         UserRole @default(CUSTOMER)
  avatar       String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  technician   Technician?
  receptionist Receptionist?
  manager      Manager?
  customer     Customer?
  appointments Appointment[]
  orders       Order[]
  reviews      Review[]
  auditLogs    AuditLog[]
}

model Customer {
  id              String   @id @default(uuid())
  userId          String   @unique
  level           Int      @default(1)
  totalSpent      Float    @default(0)
  totalAppointments Int    @default(0)
  points          Int      @default(0)
  preferences     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

model Technician {
  id              String           @id @default(uuid())
  userId          String           @unique
  status          TechnicianStatus @default(AVAILABLE)
  level           Int              @default(1)
  specialty       String?
  rating          Float            @default(5.0)
  totalReviews    Int              @default(0)
  totalServices   Int              @default(0)
  totalCommission Float            @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedules       Schedule[]
  appointments    Appointment[]
  skills          TechnicianSkill[]
  performances    Performance[]
  
  @@index([userId])
  @@index([status])
}

model TechnicianSkill {
  id           String   @id @default(uuid())
  technicianId String
  serviceId    String
  proficiency  Int      @default(3)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  service      Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  
  @@unique([technicianId, serviceId])
  @@index([technicianId])
  @@index([serviceId])
}

model Receptionist {
  id           String   @id @default(uuid())
  userId       String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

model Manager {
  id           String   @id @default(uuid())
  userId       String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

model Service {
  id            String    @id @default(uuid())
  name          String
  category      String
  description   String?
  duration      Int
  price         Float
  cost          Float
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  appointments  Appointment[]
  skills        TechnicianSkill[]
  serviceConsumables ServiceConsumable[]
  
  @@index([category])
  @@index([isActive])
}

model ServiceConsumable {
  id             String   @id @default(uuid())
  serviceId      String
  inventoryItemId String
  quantity       Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  service        Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  inventoryItem  InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  
  @@unique([serviceId, inventoryItemId])
  @@index([serviceId])
  @@index([inventoryItemId])
}

model InventoryItem {
  id             String   @id @default(uuid())
  name           String
  sku            String   @unique
  category       String
  unit           String
  currentStock   Float    @default(0)
  minStock       Float    @default(0)
  maxStock       Float    @default(100)
  price          Float
  supplier       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  serviceConsumables ServiceConsumable[]
  inventoryLogs  InventoryLog[]
  consumableUsages ConsumableUsage[]
  
  @@index([sku])
  @@index([category])
  @@index([isActive])
}

model InventoryLog {
  id             String   @id @default(uuid())
  inventoryItemId String
  actionType     InventoryActionType
  quantity       Float
  beforeQuantity Float
  afterQuantity  Float
  reason         String?
  operatorId     String
  createdAt      DateTime @default(now())
  inventoryItem  InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  
  @@index([inventoryItemId])
  @@index([createdAt])
}

model Room {
  id           String     @id @default(uuid())
  name         String
  number       String     @unique
  status       RoomStatus @default(AVAILABLE)
  capacity     Int        @default(1)
  description  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  appointments Appointment[]
  
  @@index([status])
}

model Schedule {
  id           String   @id @default(uuid())
  technicianId String
  date         DateTime
  startTime    String
  endTime      String
  isWorking    Boolean  @default(true)
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  
  @@unique([technicianId, date])
  @@index([technicianId])
  @@index([date])
}

model Appointment {
  id               String            @id @default(uuid())
  appointmentCode  String            @unique
  customerId       String
  technicianId     String
  serviceId        String
  roomId           String?
  orderId          String?
  status           AppointmentStatus @default(PENDING)
  scheduledDate    DateTime
  scheduledTime    String
  estimatedEndTime String?
  actualStartTime  DateTime?
  actualEndTime    DateTime?
  deposit          Float             @default(0)
  totalPrice       Float
  discount         Float             @default(0)
  finalPrice       Float
  serviceDetails   String?
  qrCode           String?
  cancellationReason String?
  cancelledBy      String?
  cancelledAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  customer         User              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  technician       Technician        @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  service          Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  room             Room?             @relation(fields: [roomId], references: [id], onDelete: SetNull)
  order            Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  consumableUsages ConsumableUsage[]
  reviews          Review[]
  stateTransitions StateTransition[]
  
  @@index([customerId])
  @@index([technicianId])
  @@index([serviceId])
  @@index([status])
  @@index([scheduledDate])
  @@index([appointmentCode])
}

model Order {
  id               String      @id @default(uuid())
  orderCode        String      @unique
  customerId       String
  appointmentId    String?
  status           OrderStatus @default(PENDING)
  totalAmount      Float
  discountAmount   Float       @default(0)
  paidAmount       Float       @default(0)
  paymentMethod    String?
  paidAt           DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  customer         User        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  appointment      Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  
  @@index([customerId])
  @@index([status])
  @@index([orderCode])
}

model ConsumableUsage {
  id               String   @id @default(uuid())
  appointmentId    String
  inventoryItemId  String
  quantity         Float
  unitPrice        Float
  totalPrice       Float
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  appointment      Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  inventoryItem    InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  
  @@index([appointmentId])
  @@index([inventoryItemId])
}

model Performance {
  id               String   @id @default(uuid())
  technicianId     String
  date             DateTime
  totalServices    Int      @default(0)
  totalRevenue     Float    @default(0)
  totalCommission  Float    @default(0)
  rating           Float    @default(0)
  reviewsCount     Int      @default(0)
  newCustomers     Int      @default(0)
  repeatCustomers  Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  technician       Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  
  @@unique([technicianId, date])
  @@index([technicianId])
  @@index([date])
}

model Review {
  id           String   @id @default(uuid())
  appointmentId String
  customerId   String
  technicianId String
  rating       Int
  comment      String?
  isAnonymous  Boolean  @default(false)
  isApproved   Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  appointment  Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  customer     User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  
  @@index([appointmentId])
  @@index([customerId])
  @@index([technicianId])
}

model StateTransition {
  id              String   @id @default(uuid())
  appointmentId   String
  fromStatus      AppointmentStatus?
  toStatus        AppointmentStatus
  changedBy       String
  changedAt       DateTime @default(now())
  reason          String?
  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  
  @@index([appointmentId])
  @@index([changedAt])
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  action       String
  resource     String
  resourceId   String?
  oldValue     String?
  newValue     String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
}

model ExceptionLog {
  id           String   @id @default(uuid())
  type         String
  severity     String
  message      String
  stackTrace   String?
  context      String?
  isResolved   Boolean  @default(false)
  resolvedAt   DateTime?
  resolvedBy   String?
  createdAt    DateTime @default(now())
  
  @@index([type])
  @@index([severity])
  @@index([isResolved])
  @@index([createdAt])
}

model ReplacementPlan {
  id              String   @id @default(uuid())
  appointmentId   String
  originalTechId  String
  suggestedTechId String
  reason          String
  status          String   @default("PENDING")
  customerNotified Boolean @default(false)
  customerAccepted Boolean?
  acceptedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([appointmentId])
  @@index([status])
}

model Notification {
  id           String   @id @default(uuid())
  userId       String
  title        String
  content      String
  type         String
  isRead       Boolean  @default(false)
  readAt       DateTime?
  createdAt    DateTime @default(now())
  
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}
