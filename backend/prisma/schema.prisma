generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== 系统设置 - 用户权限 ====================

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  realName  String?
  email     String?
  phone     String?
  status    String   @default("ACTIVE")
  roleId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role            Role?           @relation(fields: [roleId], references: [id])
  createdOrders   PurchaseOrder[] @relation("PurchaseOrderCreator")
  approvedOrders  PurchaseOrder[] @relation("PurchaseOrderApprover")
  
  @@map("users")
}

model Role {
  id          String           @id @default(cuid())
  name        String
  code        String           @unique
  description String?
  type        String           @default("OPERATOR")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  name        String
  code        String           @unique
  module      String
  description String?
  parentId    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  parent          Permission?        @relation("PermissionHierarchy", fields: [parentId], references: [id])
  children        Permission[]       @relation("PermissionHierarchy")
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())

  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ==================== 基础数据 - 物料、供应商、客户、仓库 ====================

model MaterialCategory {
  id          String           @id @default(cuid())
  name        String
  code        String           @unique
  description String?
  parentId    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  parent      MaterialCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    MaterialCategory[] @relation("CategoryHierarchy")
  materials   Material[]

  @@map("material_categories")
}

model Material {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  spec          String?
  unit          String
  type          String   @default("RAW_MATERIAL")
  categoryId    String?
  safetyStock   Float    @default(0)
  maxStock      Float    @default(0)
  avgCost       Float    @default(0)
  description   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category           MaterialCategory?     @relation(fields: [categoryId], references: [id])
  inventories        Inventory[]
  stockInItems       StockInItem[]
  stockOutItems      StockOutItem[]
  purchaseOrderItems PurchaseOrderItem[]
  salesOrderItems    SalesOrderItem[]
  materialRequirements MaterialRequirement[]
  bomItems           BomItem[]
  qualityInspections QualityInspection[]
  boms               Bom[]

  @@map("materials")
}

model Supplier {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  contact     String?
  phone       String?
  email       String?
  address     String?
  taxNo       String?
  bankAccount String?
  bankName    String?
  creditLimit Float    @default(0)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchaseOrders      PurchaseOrder[]
  purchaseSettlements PurchaseSettlement[]
  accountPayables     AccountPayable[]
  stockInOrders       StockIn[]

  @@map("suppliers")
}

model Customer {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  contact     String?
  phone       String?
  email       String?
  address     String?
  taxNo       String?
  bankAccount String?
  bankName    String?
  creditLimit Float    @default(0)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  salesOrders         SalesOrder[]
  accountReceivables  AccountReceivable[]
  stockOutOrders      StockOut[]

  @@map("customers")
}

model Warehouse {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  location    String?
  manager     String?
  phone       String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inventories       Inventory[]
  stockInOrders     StockIn[]
  stockOutOrders    StockOut[]
  purchaseOrders    PurchaseOrder[]
  salesOrders       SalesOrder[]

  @@map("warehouses")
}

// ==================== 仓库管理 ====================

model Inventory {
  id           String   @id @default(cuid())
  warehouseId  String
  materialId   String
  quantity     Float    @default(0)
  lockedQty    Float    @default(0)
  availableQty Float    @default(0)
  avgCost      Float    @default(0)
  totalAmount  Float    @default(0)
  lastInDate   DateTime?
  lastOutDate  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])
  material     Material  @relation(fields: [materialId], references: [id])

  @@unique([warehouseId, materialId])
  @@map("inventory")
}

model StockIn {
  id              String   @id @default(cuid())
  orderNo         String   @unique
  type            String   @default("PURCHASE")
  warehouseId     String
  supplierId      String?
  purchaseOrderId String?
  remark          String?
  status          String   @default("DRAFT")
  totalQty        Float    @default(0)
  totalAmount     Float    @default(0)
  operatorId      String?
  approvedAt      DateTime?
  approvedById    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  warehouse       Warehouse       @relation(fields: [warehouseId], references: [id])
  supplier        Supplier?       @relation(fields: [supplierId], references: [id])
  purchaseOrder   PurchaseOrder?  @relation(fields: [purchaseOrderId], references: [id])
  items           StockInItem[]

  @@map("stock_in")
}

model StockInItem {
  id        String   @id @default(cuid())
  stockInId String
  materialId String
  batchNo   String?
  quantity  Float    @default(0)
  unitPrice Float    @default(0)
  amount    Float    @default(0)
  remark    String?
  createdAt DateTime @default(now())

  stockIn  StockIn  @relation(fields: [stockInId], references: [id])
  material Material @relation(fields: [materialId], references: [id])

  @@map("stock_in_items")
}

model StockOut {
  id             String   @id @default(cuid())
  orderNo        String   @unique
  type           String   @default("SALES")
  warehouseId    String
  customerId     String?
  salesOrderId   String?
  remark         String?
  status         String   @default("DRAFT")
  totalQty       Float    @default(0)
  totalAmount    Float    @default(0)
  operatorId     String?
  approvedAt     DateTime?
  approvedById   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  warehouse    Warehouse     @relation(fields: [warehouseId], references: [id])
  customer     Customer?     @relation(fields: [customerId], references: [id])
  salesOrder   SalesOrder?   @relation(fields: [salesOrderId], references: [id])
  items        StockOutItem[]

  @@map("stock_out")
}

model StockOutItem {
  id         String   @id @default(cuid())
  stockOutId String
  materialId String
  batchNo    String?
  quantity   Float    @default(0)
  unitPrice  Float    @default(0)
  amount     Float    @default(0)
  remark     String?
  createdAt  DateTime @default(now())

  stockOut  StockOut @relation(fields: [stockOutId], references: [id])
  material  Material @relation(fields: [materialId], references: [id])

  @@map("stock_out_items")
}

// ==================== 采购管理 ====================

model PurchaseOrder {
  id           String   @id @default(cuid())
  orderNo      String   @unique
  supplierId   String
  warehouseId  String
  orderDate    DateTime @default(now())
  expectedDate DateTime?
  remark       String?
  status       String   @default("DRAFT")
  totalQty     Float    @default(0)
  totalAmount  Float    @default(0)
  taxAmount    Float    @default(0)
  paidAmount   Float    @default(0)
  createdById  String?
  approvedAt   DateTime?
  approvedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  supplier     Supplier             @relation(fields: [supplierId], references: [id])
  warehouse    Warehouse            @relation(fields: [warehouseId], references: [id])
  createdBy    User?                @relation("PurchaseOrderCreator", fields: [createdById], references: [id])
  approvedBy   User?                @relation("PurchaseOrderApprover", fields: [approvedById], references: [id])
  items        PurchaseOrderItem[]
  stockInOrders StockIn[]
  settlements  PurchaseSettlement[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String   @id @default(cuid())
  purchaseOrderId  String
  materialId       String
  quantity         Float    @default(0)
  receivedQty      Float    @default(0)
  unitPrice        Float    @default(0)
  amount           Float    @default(0)
  taxRate          Float    @default(0)
  taxAmount        Float    @default(0)
  remark           String?
  createdAt        DateTime @default(now())

  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  material         Material @relation(fields: [materialId], references: [id])

  @@map("purchase_order_items")
}

model PurchaseSettlement {
  id               String   @id @default(cuid())
  settlementNo     String   @unique
  purchaseOrderId  String
  supplierId       String
  settlementDate   DateTime @default(now())
  totalAmount      Float    @default(0)
  paidAmount       Float    @default(0)
  unpaidAmount     Float    @default(0)
  paymentMethod    String?
  remark           String?
  status           String   @default("DRAFT")
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  supplier         Supplier @relation(fields: [supplierId], references: [id])
  accountPayables  AccountPayable[]

  @@map("purchase_settlements")
}

// ==================== 销售管理 ====================

model SalesOrder {
  id           String   @id @default(cuid())
  orderNo      String   @unique
  customerId   String
  warehouseId  String
  orderDate    DateTime @default(now())
  deliveryDate DateTime?
  remark       String?
  status       String   @default("DRAFT")
  totalQty     Float    @default(0)
  totalAmount  Float    @default(0)
  taxAmount    Float    @default(0)
  receivedAmount Float  @default(0)
  createdById  String?
  approvedAt   DateTime?
  approvedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer          Customer            @relation(fields: [customerId], references: [id])
  warehouse         Warehouse           @relation(fields: [warehouseId], references: [id])
  items             SalesOrderItem[]
  stockOutOrders    StockOut[]
  accountReceivables AccountReceivable[]

  @@map("sales_orders")
}

model SalesOrderItem {
  id               String   @id @default(cuid())
  salesOrderId     String
  materialId       String
  quantity         Float    @default(0)
  shippedQty       Float    @default(0)
  unitPrice        Float    @default(0)
  amount           Float    @default(0)
  taxRate          Float    @default(0)
  taxAmount        Float    @default(0)
  remark           String?
  createdAt        DateTime @default(now())

  salesOrder       SalesOrder @relation(fields: [salesOrderId], references: [id])
  material         Material @relation(fields: [materialId], references: [id])

  @@map("sales_order_items")
}

// ==================== 生产制造 ====================

model ProductionPlan {
  id           String   @id @default(cuid())
  planNo       String   @unique
  name         String
  planDate     DateTime @default(now())
  startDate    DateTime?
  endDate      DateTime?
  remark       String?
  status       String   @default("DRAFT")
  createdById  String?
  approvedAt   DateTime?
  approvedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  materialRequirements MaterialRequirement[]

  @@map("production_plans")
}

model Bom {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  productId   String
  description String?
  isActive    Boolean  @default(true)
  version     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product     Material  @relation(fields: [productId], references: [id])
  items       BomItem[]

  @@map("boms")
}

model BomItem {
  id        String   @id @default(cuid())
  bomId     String
  materialId String
  quantity  Float    @default(0)
  remark    String?
  createdAt DateTime @default(now())

  bom       Bom      @relation(fields: [bomId], references: [id])
  material  Material @relation(fields: [materialId], references: [id])

  @@map("bom_items")
}

model MaterialRequirement {
  id                String   @id @default(cuid())
  productionPlanId  String
  materialId        String
  requiredQty       Float    @default(0)
  availableQty      Float    @default(0)
  shortQty          Float    @default(0)
  unit              String?
  remark            String?
  createdAt         DateTime @default(now())

  productionPlan    ProductionPlan @relation(fields: [productionPlanId], references: [id])
  material          Material @relation(fields: [materialId], references: [id])

  @@map("material_requirements")
}

// ==================== 质检管理 ====================

model QualityInspection {
  id              String   @id @default(cuid())
  inspectionNo    String   @unique
  type            String
  sourceType      String?
  sourceId        String?
  materialId      String
  batchNo         String?
  quantity        Float    @default(0)
  sampleQty       Float    @default(0)
  inspectedQty    Float    @default(0)
  passedQty       Float    @default(0)
  failedQty       Float    @default(0)
  result          String   @default("PENDING")
  inspectorId     String?
  inspectionDate  DateTime?
  remark          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  material        Material @relation(fields: [materialId], references: [id])

  @@map("quality_inspections")
}

// ==================== 财务管理 ====================

model AccountPayable {
  id               String   @id @default(cuid())
  payableNo        String   @unique
  supplierId       String
  settlementId     String?
  amount           Float    @default(0)
  paidAmount       Float    @default(0)
  unpaidAmount     Float    @default(0)
  status           String   @default("UNPAID")
  dueDate          DateTime?
  paidDate         DateTime?
  remark           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  supplier         Supplier      @relation(fields: [supplierId], references: [id])
  settlement       PurchaseSettlement? @relation(fields: [settlementId], references: [id])

  @@map("account_payables")
}

model AccountReceivable {
  id               String   @id @default(cuid())
  receivableNo     String   @unique
  customerId       String
  salesOrderId     String?
  amount           Float    @default(0)
  receivedAmount   Float    @default(0)
  unreceivedAmount Float    @default(0)
  status           String   @default("UNPAID")
  dueDate          DateTime?
  receivedDate     DateTime?
  remark           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  customer         Customer      @relation(fields: [customerId], references: [id])
  salesOrder       SalesOrder?   @relation(fields: [salesOrderId], references: [id])

  @@map("account_receivables")
}

// ==================== 人力资源 ====================

model Employee {
  id            String   @id @default(cuid())
  employeeNo    String   @unique
  name          String
  gender        String?
  birthday      DateTime?
  idCard        String?
  phone         String?
  email         String?
  address       String?
  department    String?
  position      String?
  status        String   @default("ACTIVE")
  hireDate      DateTime?
  resignDate    DateTime?
  bankAccount   String?
  bankName      String?
  socialSecurityNo String?
  remark        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("employees")
}
