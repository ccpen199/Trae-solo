generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  username        String    @unique
  password        String
  email           String?   @unique
  phone           String?   @unique
  role            String    @default("USER")
  balance         Float     @default(0)
  status          String    @default("ACTIVE")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  sellerAccounts  GameAccount[]
  buyerOrders     Order[]       @relation("BuyerOrders")
  sellerOrders    Order[]       @relation("SellerOrders")
  createdExceptions Exception[]
  
  @@map("users")
}

model GameAccount {
  id              String        @id @default(uuid())
  title           String
  description     String?
  gameName        String
  gameServer      String?
  accountLevel    Int?          @default(1)
  price           Float
  originalPrice   Float?
  sellerId        String
  status          String        @default("PENDING_REVIEW")
  viewCount       Int           @default(0)
  favoriteCount   Int           @default(0)
  isTop           Boolean       @default(false)
  isHot           Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  seller          User          @relation(fields: [sellerId], references: [id])
  orders          Order[]
  images          AccountImage[]
  favorites       Favorite[]
  
  @@map("game_accounts")
}

model AccountImage {
  id              String    @id @default(uuid())
  accountId       String
  url             String
  sort            Int       @default(0)
  isMain          Boolean   @default(false)
  createdAt       DateTime  @default(now())
  
  account         GameAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  
  @@map("account_images")
}

model Order {
  id              String        @id @default(uuid())
  orderNo         String        @unique
  accountId       String
  buyerId         String
  sellerId        String
  price           Float
  status          String        @default("PENDING_PAYMENT")
  paymentMethod   String?
  paidAt          DateTime?
  deliveryInfo    String?
  deliveredAt     DateTime?
  confirmedAt     DateTime?
  completedAt     DateTime?
  canceledAt      DateTime?
  cancelReason    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  account         GameAccount   @relation(fields: [accountId], references: [id])
  buyer           User          @relation("BuyerOrders", fields: [buyerId], references: [id])
  seller          User          @relation("SellerOrders", fields: [sellerId], references: [id])
  exceptions      Exception[]
  
  @@map("orders")
}

model Favorite {
  id              String    @id @default(uuid())
  userId          String
  accountId       String
  createdAt       DateTime  @default(now())
  
  account         GameAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  
  @@unique([userId, accountId])
  @@map("favorites")
}

model Exception {
  id              String          @id @default(uuid())
  orderId         String?
  type            String
  title           String
  description     String?
  status          String          @default("PENDING")
  priority        String          @default("MEDIUM")
  handlerId       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  resolvedAt      DateTime?
  resolution      String?
  
  order           Order?          @relation(fields: [orderId], references: [id])
  handler         User?           @relation(fields: [handlerId], references: [id])
  logs            ExceptionLog[]
  
  @@map("exceptions")
}

model ExceptionLog {
  id              String    @id @default(uuid())
  exceptionId     String
  operatorId      String?
  action          String
  description     String?
  createdAt       DateTime  @default(now())
  
  exception       Exception @relation(fields: [exceptionId], references: [id], onDelete: Cascade)
  
  @@map("exception_logs")
}

model Todo {
  id              String    @id @default(uuid())
  title           String
  description     String?
  type            String
  status          String    @default("PENDING")
  priority        String    @default("MEDIUM")
  relatedId       String?
  relatedType     String?
  assigneeId      String?
  dueAt           DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@map("todos")
}
