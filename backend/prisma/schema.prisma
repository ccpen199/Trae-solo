generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                   String          @id @default(uuid())
  phone                String          @unique
  name                 String
  idCardEncrypted      String
  email                String?         @unique
  avatar               String?
  passwordHash         String
  role                 String          @default("USER")
  status               String          @default("PENDING")
  institutionId        String?
  insuranceCompanyId   String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  institution          Institution?    @relation(fields: [institutionId], references: [id])
  insuranceCompany     InsuranceCompany? @relation(fields: [insuranceCompanyId], references: [id])
  bookings             Booking[]
  insuranceOrders      InsuranceOrder[]
  healthArchives       HealthArchive[]
  riskAssessments      RiskAssessment[]
  auditLogs            AuditLog[]

  @@index([institutionId])
  @@index([insuranceCompanyId])
  @@index([role])
  @@index([status])
}

model Institution {
  id                   String             @id @default(uuid())
  name                 String
  type                 String
  city                 String
  address              String
  phone                String
  level                String?
  description          String?
  logoUrl              String?
  status               String             @default("PENDING")
  approvedAt           DateTime?
  approvedBy           String?
  hisApiConfigEncrypted String
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  users                User[]
  healthPackages       HealthPackage[]

  @@index([type])
  @@index([status])
  @@index([city])
}

model HealthPackage {
  id                   String          @id @default(uuid())
  institutionId        String
  name                 String
  type                 String
  price                Decimal
  originalPrice        Decimal?
  ageMin               Int
  ageMax               Int
  gender               String
  city                 String
  items                String
  description          String?
  notice               String?
  status               String          @default("DRAFT")
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  institution          Institution     @relation(fields: [institutionId], references: [id])
  bookings             Booking[]

  @@index([institutionId])
  @@index([type])
  @@index([status])
  @@index([city])
}

model Booking {
  id                   String             @id @default(uuid())
  userId               String
  packageId            String
  checkupDate          DateTime
  checkupTime          String
  checkupPersonEncrypted String
  status               String             @default("PENDING")
  hisSyncStatus        String             @default("NOT_SYNCED")
  hisOrderId           String?
  paymentStatus        String             @default("UNPAID")
  amount               Decimal
  reportId             String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user                 User               @relation(fields: [userId], references: [id])
  healthPackage        HealthPackage      @relation(fields: [packageId], references: [id])
  healthArchive        HealthArchive?

  @@index([userId])
  @@index([packageId])
  @@index([status])
  @@index([checkupDate])
  @@index([paymentStatus])
  @@index([hisSyncStatus])
}

model InsuranceCompany {
  id                   String             @id @default(uuid())
  name                 String
  logoUrl              String?
  description          String?
  licenseNumber        String
  contactName          String
  contactPhone         String
  apiConfigEncrypted   String
  commissionRate       Decimal
  status               String             @default("PENDING")
  approvedAt           DateTime?
  approvedBy           String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  users                User[]
  products             InsuranceProduct[]
  settlements          Settlement[]

  @@index([status])
}

model InsuranceProduct {
  id                   String                @id @default(uuid())
  companyId            String
  name                 String
  type                 String
  coverage             String
  premium              Decimal
  underwritingRules    String
  description          String?
  status               String                @default("DRAFT")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  company              InsuranceCompany      @relation(fields: [companyId], references: [id])
  orders               InsuranceOrder[]

  @@index([companyId])
  @@index([type])
  @@index([status])
}

model InsuranceOrder {
  id                   String             @id @default(uuid())
  userId               String
  productId            String
  policyNumber         String?
  applicantEncrypted   String
  insuredEncrypted     String
  beneficiary          String?
  assessmentResult     String?
  premium              Decimal
  status               String             @default("PENDING_ASSESSMENT")
  effectiveDate        DateTime?
  expiryDate           DateTime?
  settlementId         String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user                 User               @relation(fields: [userId], references: [id])
  product              InsuranceProduct   @relation(fields: [productId], references: [id])
  settlement           Settlement?        @relation(fields: [settlementId], references: [id])

  @@index([userId])
  @@index([productId])
  @@index([status])
  @@index([settlementId])
}

model HealthArchive {
  id                   String          @id @default(uuid())
  userId               String
  bookingId            String          @unique
  reportDate           DateTime        @default(now())
  reportUrl            String
  ocrStatus            String          @default("NOT_STARTED")
  structuredData       String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  user                 User            @relation(fields: [userId], references: [id])
  booking              Booking         @relation(fields: [bookingId], references: [id])
  indicators           HealthIndicator[]
  abnormalIndicators   AbnormalIndicator[]

  @@index([userId])
  @@index([bookingId])
  @@index([ocrStatus])
}

model HealthIndicator {
  id                   String          @id @default(uuid())
  archiveId            String
  category             String
  name                 String
  value                String
  unit                 String?
  referenceRange       String?
  status               String          @default("NORMAL")
  measureDate          DateTime?
  createdAt            DateTime        @default(now())

  archive              HealthArchive   @relation(fields: [archiveId], references: [id])

  @@index([archiveId])
  @@index([category])
  @@index([status])
}

model AbnormalIndicator {
  id                   String          @id @default(uuid())
  archiveId            String
  name                 String
  value                String
  referenceRange       String
  level                String          @default("MILD")
  description          String?
  createdAt            DateTime        @default(now())

  archive              HealthArchive   @relation(fields: [archiveId], references: [id])

  @@index([archiveId])
  @@index([level])
}

model RiskAssessment {
  id                   String          @id @default(uuid())
  userId               String
  assessmentDate       DateTime        @default(now())
  diabetesRisk         Decimal
  hypertensionRisk     Decimal
  cardiovascularRisk   Decimal
  overallScore         Int
  suggestions          String
  createdAt            DateTime        @default(now())

  user                 User            @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([assessmentDate])
}

model Settlement {
  id                   String             @id @default(uuid())
  companyId            String
  period               String
  totalPremium         Decimal
  commissionRate       Decimal
  commissionAmount     Decimal
  orderCount           Int
  status               String             @default("PENDING")
  paidAt               DateTime?
  createdAt            DateTime           @default(now())

  company              InsuranceCompany   @relation(fields: [companyId], references: [id])
  orders               InsuranceOrder[]

  @@index([companyId])
  @@index([status])
  @@index([period])
}

model AuditLog {
  id                   String          @id @default(uuid())
  userId               String
  action               String
  targetType           String
  targetId             String?
  ipAddress            String?
  userAgent            String?
  requestDataEncrypted String?
  responseDataEncrypted String?
  createdAt            DateTime        @default(now())

  user                 User            @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([targetType])
  @@index([createdAt])
}
