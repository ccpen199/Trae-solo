    "lodash": "^4.17.21",
    "moment": "^2.30.0",
    "node-fetch": "^3.3.0",
    "uuid": "^9.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "prisma": "^5.10.0"
  }
