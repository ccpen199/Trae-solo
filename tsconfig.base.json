{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["shared/*"],
      "@backend/*": ["backend/src/*"],
      "@admin/*": ["admin/src/*"],
      "@miniapp/*": ["miniapp/src/*"]
    }
  },
  "include": ["shared/**/*", "backend/src/**/*", "admin/src/**/*", "miniapp/src/**/*"],
  "exclude": ["node_modules", "dist", "build"]
}
