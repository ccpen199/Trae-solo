{
  "name": "pet-life-platform",
  "version": "1.0.0",
  "private": true,
  "description": "面向宠物主的全栈式宠物生活服务平台",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@pet/api",
    "dev:web": "turbo run dev --filter=@pet/web",
    "dev:admin": "turbo run dev --filter=@pet/admin",
    "db:generate": "pnpm --filter=@pet/db generate",
    "db:migrate": "pnpm --filter=@pet/db migrate",
    "db:seed": "pnpm --filter=@pet/db seed",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "@types/node": "^20.11.0"
  },
  "engines": {
    "node": ">=18.17.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4"
}
