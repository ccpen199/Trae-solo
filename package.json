{
  "name": "home-decoration-saas",
  "version": "1.0.0",
  "description": "家装产业协同SaaS平台",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm --prefix frontend install && npm --prefix backend install",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "start:frontend": "node scripts/spawn_services.js frontend",
    "start:backend": "node scripts/spawn_services.js backend",
    "start": "node scripts/spawn_services.js",
    "stop": "node scripts/stop.js",
    "check": "node scripts/check.js"
  },
  "keywords": ["saas", "home-decoration", "decoration"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
