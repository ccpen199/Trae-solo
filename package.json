{
  "name": "construction-labor-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install --workspaces",
    "dev": "concurrently \"npm --workspace=backend run dev\" \"npm --workspace=frontend run dev\"",
    "build": "npm --workspace=backend run build && npm --workspace=frontend run build",
    "start:backend": "npm --workspace=backend run start",
    "start:frontend": "npm --workspace=frontend run preview"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
