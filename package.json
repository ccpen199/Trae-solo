{
  "name": "community-service-platform",
  "version": "1.0.0",
  "private": true,
  "description": "面向住宅小区的社区服务中台系统",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=@community/backend",
    "dev:admin": "npm run dev --workspace=@community/admin",
    "dev:mini": "npm run dev:weapp --workspace=@community/mini",
    "build:backend": "npm run build --workspace=@community/backend",
    "build:admin": "npm run build --workspace=@community/admin",
    "build:mini": "npm run build:weapp --workspace=@community/mini",
    "prisma:generate": "npm run prisma:generate --workspace=@community/backend",
    "prisma:migrate": "npm run prisma:migrate --workspace=@community/backend",
    "start:backend": "npm run start:prod --workspace=@community/backend"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
