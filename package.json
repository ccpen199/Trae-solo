{
  "name": "hospital-system",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=@hospital/backend",
    "dev:frontend": "npm run dev --workspace=@hospital/frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm run build --workspace=@hospital/backend",
    "build:frontend": "npm run build --workspace=@hospital/frontend",
    "db:start": "docker-compose up -d",
    "db:stop": "docker-compose down",
    "db:prisma:migrate": "npm run prisma:migrate --workspace=@hospital/backend",
    "db:prisma:seed": "npm run prisma:seed --workspace=@hospital/backend",
    "db:prisma:generate": "npm run prisma:generate --workspace=@hospital/backend",
    "db:prisma:studio": "npm run prisma:studio --workspace=@hospital/backend",
    "install:all": "npm install",
    "start:infra": "npm run db:start",
    "start:app": "npm run dev",
    "start": "npm run db:start && sleep 5 && npm run db:prisma:migrate && npm run db:prisma:seed && npm run dev"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
