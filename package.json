{
  "name": "henan-student-funding-platform",
  "version": "1.0.0",
  "description": "河南省中职学生资助监管服务平台",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n frontend,backend -c cyan,magenta \"npm:dev:frontend\" \"npm:dev:backend\"",
    "dev:frontend": "vite --host 127.0.0.1 --port 49097 --strictPort",
    "dev:backend": "tsx watch --tsconfig api/tsconfig.json api/index.ts",
    "build": "tsc && vite build",
    "build:frontend": "tsc && vite build",
    "build:backend": "tsc --project api/tsconfig.json",
    "start": "node dist/api/index.js",
    "start:backend": "tsx --tsconfig api/tsconfig.json api/index.ts",
    "db:init": "tsx --tsconfig api/tsconfig.json api/database/init.ts",
    "db:migrate": "tsx --tsconfig api/tsconfig.json api/database/migrate.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "antd-mobile": "^5.38.1",
    "dotenv": "^16.4.5",
    "antd-mobile-icons": "^0.3.0",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.5.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "localforage": "^1.10.0",
    "lucide-react": "^0.453.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "recharts": "^2.13.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.8.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
