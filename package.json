{
  "name": "zz-government-hub",
  "version": "1.0.0",
  "private": true,
  "description": "郑州市掌上办事中枢平台 - 城市级政务服务一体化平台",
  "scripts": {
    "dev:miniapp": "cd miniapp && npm run dev:weapp",
    "dev:admin": "cd admin && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "dev:all": "concurrently \"npm:dev:miniapp\" \"npm:dev:admin\" \"npm:dev:backend\"",
    "build:miniapp": "cd miniapp && npm run build:weapp",
    "build:admin": "cd admin && npm run build",
    "build:backend": "cd backend && npm run build",
    "lint": "eslint \"**/*.{ts,tsx,js,vue}\" --fix"
  },
  "keywords": [
    "政务服务",
    "郑州",
    "小程序",
    "数字画像",
    "知识图谱",
    "服务编排"
  ],
  "author": "Zhengzhou Government Hub Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
