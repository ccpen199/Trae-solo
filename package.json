{
  "name": "campus-water-iot-platform",
  "version": "1.0.0",
  "description": "校园直饮水IoT服务平台 - 覆盖学生、运维方、投资商三方角色",
  "private": true,
  "workspaces": [
    "backend",
    "admin/investor",
    "admin/operator",
    "miniprogram"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:backend\" \"npm:dev:investor\" \"npm:dev:operator\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:investor": "cd admin/investor && npm run dev",
    "dev:operator": "cd admin/operator && npm run dev",
    "dev:miniprogram": "cd miniprogram && npm run dev:weapp",
    "build": "npm run build:backend && npm run build:investor && npm run build:operator",
    "build:backend": "cd backend && npm run build",
    "build:investor": "cd admin/investor && npm run build",
    "build:operator": "cd admin/operator && npm run build",
    "build:miniprogram": "cd miniprogram && npm run build:weapp",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "lint": "npm run lint:backend && npm run lint:investor && npm run lint:operator",
    "lint:backend": "cd backend && npm run lint",
    "lint:investor": "cd admin/investor && npm run lint",
    "lint:operator": "cd admin/operator && npm run lint",
    "test": "npm run test:backend",
    "test:backend": "cd backend && npm run test",
    "init:env": "cp .env.example .env && cp backend/.env.example backend/.env"
  },
  "keywords": [
    "iot",
    "water-dispenser",
    "campus",
    "mqtt",
    "miniprogram"
  ],
  "author": "Campus Water IoT Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
