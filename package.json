{
  "name": "meteorological-warning-system",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm --prefix server run dev\" \"npm --prefix web run dev\"",
    "dev:server": "npm --prefix server run dev",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "start": "npm --prefix server run start",
    "seed": "npm --prefix server run seed",
    "test": "npm --prefix server run test",
    "init": "npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}