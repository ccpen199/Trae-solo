generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  phone        String?   @unique
  password     String
  name         String
  avatar       String?
  role         String    @default("JOB_SEEKER")
  verified     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  jobSeeker    JobSeeker?
  employer     Employer?

  activities   UserActivity[]
  viewRecords  ViewRecord[]
  notifications Notification[]

  @@index([role, email])
}

model JobSeeker {
  id              String    @id @default(cuid())
  userId          String    @unique
  birthDate       DateTime?
  gender          String?
  location        String?
  currentTitle    String?
  expectedSalary  Int?
  workYears       Float?
  highestDegree   String?
  major           String?
  school          String?
  jobStatus       String?
  tags            String?
  skills          String?
  summary         String?

  user            User      @relation(fields: [userId], references: [id])
  resumes         Resume[]
  applications    JobApplication[]
  interviews      VideoInterview[]
  profile         CandidateProfile?
  checkInRecords  CheckInRecord[]

  @@index([location, workYears])
}

model Employer {
  id               String         @id @default(cuid())
  userId           String         @unique
  companyId        String
  position         String?
  department       String?
  isHr             Boolean        @default(false)
  isAdmin          Boolean        @default(false)

  user             User           @relation(fields: [userId], references: [id])
  company          Company        @relation(fields: [companyId], references: [id])
  postedJobs       Job[]
  liveStreams      LiveStream[]
  salaryReports    SalaryReport[]

  @@index([companyId, isHr])
}

model Company {
  id               String    @id @default(cuid())
  name             String    @unique
  logo             String?
  banner           String?
  industry         String?
  size             String?
  foundedYear      Int?
  headquarters     String?
  benefits         String?
  contactEmail     String?
  contactPhone     String?
  website          String?
  description      String?
  cultureValues    String?
  verified         Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  employers        Employer[]
  jobs             Job[]
  liveStreams      LiveStream[]
  vrTours          VRTour[]
  teamVlogs        TeamVlog[]
  cultureTags      CultureTag[]
  viewRecords      ViewRecord[]
  jobHeatmaps      JobHeatmap[]
  hrActivities     HrActivity[]
  salaryReports    SalaryReport[]
  jobFairs         JobFair[]
  booths           FairBooth[]

  @@index([industry, verified])
}

model Job {
  id                  String     @id @default(cuid())
  companyId           String
  employerId          String
  title               String
  description         String?
  requirements        String?
  responsibilities    String?
  city                String?
  district            String?
  address             String?
  salaryMin           Int?
  salaryMax           Int?
  salaryType          String?
  tags                String?
  keywords            String?
  certificateRequirement String?
  experienceMin       Float?
  experienceMax       Float?
  educationMin        String?
  jobType             String?
  department          String?
  status              String     @default("ACTIVE")
  viewsCount          Int        @default(0)
  clicksCount         Int        @default(0)
  applicationsCount   Int        @default(0)
  priority            Int        @default(0)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  deadline            DateTime?

  company             Company    @relation(fields: [companyId], references: [id])
  postedBy            Employer   @relation(fields: [employerId], references: [id])
  applications        JobApplication[]
  liveJobMounts       LiveJobMount[]
  heatmap             JobHeatmap?
  fairBooths          FairBooth[]
  resumeCollections   ResumeCollection[]
  recommendations     JobRecommendation[]
  aiScreeningTasks  AIScreeningTask[]

  @@index([companyId, status])
  @@index([city, salaryMin])
}

model Resume {
  id              String    @id @default(cuid())
  jobSeekerId     String
  resumeFile      String?
  resumeText      String?
  isDefault       Boolean   @default(false)
  title           String?
  summary         String?
  parsedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  jobSeeker       JobSeeker @relation(fields: [jobSeekerId], references: [id])
  educations      Education[]
  workExperiences WorkExperience[]
  projects        ProjectExperience[]
  certificates    Certificate[]
  applications    JobApplication[]

  @@index([jobSeekerId, isDefault])
}

model Education {
  id             String    @id @default(cuid())
  resumeId       String
  school         String
  major          String?
  degree         String?
  startDate      DateTime?
  endDate        DateTime?
  description    String?
  gpa            Float?
  sortOrder      Int       @default(0)

  resume         Resume    @relation(fields: [resumeId], references: [id])

  @@index([resumeId, sortOrder])
}

model WorkExperience {
  id            String    @id @default(cuid())
  resumeId      String
  company       String
  position      String
  startDate     DateTime?
  endDate       DateTime?
  isCurrent     Boolean   @default(false)
  description   String?
  achievements  String?
  skillsUsed    String?
  salary        Int?
  sortOrder     Int       @default(0)

  resume        Resume    @relation(fields: [resumeId], references: [id])

  @@index([resumeId, sortOrder])
}

model ProjectExperience {
  id           String    @id @default(cuid())
  resumeId     String
  name         String
  role         String?
  startDate    DateTime?
  endDate      DateTime?
  description  String?
  technologies String?
  link         String?
  sortOrder    Int       @default(0)

  resume       Resume    @relation(fields: [resumeId], references: [id])

  @@index([resumeId, sortOrder])
}

model Certificate {
  id           String    @id @default(cuid())
  resumeId     String
  name         String
  issuer       String?
  issueDate    DateTime?
  expireDate   DateTime?
  credentialId String?
  sortOrder    Int       @default(0)

  resume       Resume    @relation(fields: [resumeId], references: [id])

  @@index([resumeId, sortOrder])
}

model JobApplication {
  id            String    @id @default(cuid())
  jobId         String
  jobSeekerId   String
  resumeId      String
  status        String    @default("APPLIED")
  source        String?
  coverLetter   String?
  aiScore       Float?
  aiMatchReason String?
  appliedAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  viewedAt      DateTime?
  viewedBy      String?

  job           Job       @relation(fields: [jobId], references: [id])
  jobSeeker     JobSeeker @relation(fields: [jobSeekerId], references: [id])
  resume        Resume    @relation(fields: [resumeId], references: [id])
  interviews    VideoInterview[]

  @@index([jobId, status])
  @@index([jobSeekerId, status])
  @@unique([jobId, jobSeekerId])
}

model VideoInterview {
  id            String    @id @default(cuid())
  applicationId String?
  jobSeekerId   String
  employerId    String?
  interviewType String    @default("LIVE_VIDEO")
  status        String    @default("SCHEDULED")
  title         String?
  scheduledAt   DateTime?
  duration      Int       @default(30)
  roomUrl       String?
  streamUrl     String?
  recordingUrl  String?
  recordingSize Int?
  recordingTime Float?
  notes         String?
  rating        Int?
  aiAnalysis    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  startedAt     DateTime?
  endedAt       DateTime?

  application   JobApplication? @relation(fields: [applicationId], references: [id])
  jobSeeker     JobSeeker     @relation(fields: [jobSeekerId], references: [id])
  slots         InterviewSlot[]
  recordings    InterviewRecording[]

  @@index([jobSeekerId, status])
  @@index([status, scheduledAt])
}

model InterviewSlot {
  id            String   @id @default(cuid())
  interviewId   String
  startTime     DateTime
  endTime       DateTime
  isBooked      Boolean  @default(false)
  bookedBy      String?

  interview     VideoInterview @relation(fields: [interviewId], references: [id])

  @@index([interviewId, isBooked])
}

model InterviewRecording {
  id           String   @id @default(cuid())
  interviewId  String
  recordingUrl String
  duration     Float?
  size         Int?
  format       String?
  createdAt    DateTime @default(now())

  interview    VideoInterview @relation(fields: [interviewId], references: [id])
}

model LiveStream {
  id              String    @id @default(cuid())
  companyId       String
  employerId      String
  title           String
  coverImage      String?
  description     String?
  status          String    @default("DRAFT")
  pushUrl         String?
  pushKey         String?
  playUrl         String?
  scheduledAt     DateTime?
  startedAt       DateTime?
  endedAt         DateTime?
  duration        Int?
  peakViewers     Int       @default(0)
  totalViewers    Int       @default(0)
  totalLikes      Int       @default(0)
  totalDanmakus   Int       @default(0)
  totalShares     Int       @default(0)
  recorded        Boolean   @default(false)
  recordingUrl    String?
  category        String?
  jobCount        Int       @default(0)
  danmakuEnabled  Boolean   @default(true)
  danmakuModerated Boolean  @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company         Company   @relation(fields: [companyId], references: [id])
  host            Employer  @relation(fields: [employerId], references: [id])
  danmakus        LiveDanmaku[]
  jobMounts       LiveJobMount[]
  invites         LiveInvite[]

  @@index([companyId, status])
  @@index([status, scheduledAt])
}

model LiveDanmaku {
  id         String   @id @default(cuid())
  liveId     String
  userId     String?
  userType   String?
  username   String
  content    String
  status     String   @default("APPROVED")
  isHost     Boolean  @default(false)
  color      String?
  createdAt  DateTime @default(now())

  liveStream LiveStream @relation(fields: [liveId], references: [id])

  @@index([liveId, status])
  @@index([liveId, createdAt])
}

model LiveJobMount {
  id           String   @id @default(cuid())
  liveId       String
  jobId        String
  isPinned     Boolean  @default(false)
  sortOrder    Int      @default(0)
  clickCount   Int      @default(0)
  applyCount   Int      @default(0)
  createdAt    DateTime @default(now())

  liveStream   LiveStream @relation(fields: [liveId], references: [id])
  job          Job      @relation(fields: [jobId], references: [id])

  @@index([liveId, sortOrder])
  @@unique([liveId, jobId])
}

model LiveInvite {
  id          String   @id @default(cuid())
  liveId      String
  userId      String
  username    String
  avatar      String?
  position    String?
  matchScore  Float?
  status      String   @default("PENDING")
  requestedAt DateTime @default(now())
  acceptedAt  DateTime?
  endedAt     DateTime?
  duration    Int?

  liveStream  LiveStream @relation(fields: [liveId], references: [id])

  @@index([liveId, status])
}

model VRTour {
  id           String   @id @default(cuid())
  companyId    String
  title        String
  description  String?
  panoramaUrl  String
  tourData     String?
  hotspots     String?
  sortOrder    Int      @default(0)
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())

  company      Company  @relation(fields: [companyId], references: [id])

  @@index([companyId, status])
}

model TeamVlog {
  id          String   @id @default(cuid())
  companyId   String
  title       String
  description String?
  thumbnail   String?
  videoUrl    String
  duration    Int?
  viewsCount  Int      @default(0)
  likesCount  Int      @default(0)
  author      String?
  sortOrder   Int      @default(0)
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())

  company     Company  @relation(fields: [companyId], references: [id])

  @@index([companyId, status])
}

model CultureTag {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  icon        String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  company     Company  @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@unique([companyId, name])
}

model ViewRecord {
  id           String   @id @default(cuid())
  viewerId     String
  targetType   String
  targetId     String
  companyId    String?
  duration     Float?
  heatmapPoints String?
  viewDate     DateTime @default(now())

  viewer       User     @relation(fields: [viewerId], references: [id])
  company      Company? @relation(fields: [companyId], references: [id])

  @@index([viewerId, targetType])
  @@index([targetType, targetId])
  @@index([viewDate])
}

model JobHeatmap {
  id           String   @id @default(cuid())
  jobId        String  @unique
  companyId    String
  viewsCount   Int      @default(0)
  clicksCount  Int      @default(0)
  applyCount   Int      @default(0)
  avgViewTime  Float?
  heatmapData  String?
  updatedAt    DateTime @updatedAt

  job          Job      @relation(fields: [jobId], references: [id])
  company      Company  @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model HrActivity {
  id        String   @id @default(cuid())
  companyId String
  hrId      String
  action    String
  targetType String?
  targetId   String?
  metadata   String?
  createdAt  DateTime @default(now())

  company    Company  @relation(fields: [companyId], references: [id])

  @@index([companyId, hrId])
  @@index([action, createdAt])
}

model SalaryData {
  id          String   @id @default(cuid())
  jobTitle    String
  city        String
  industry    String?
  experience  String?
  education   String?
  p10Salary   Float?
  p25Salary   Float?
  p50Salary   Float?
  p75Salary   Float?
  p90Salary   Float?
  avgSalary   Float?
  sampleSize  Int      @default(0)
  dataSource  String?
  updatedAt   DateTime @updatedAt

  @@index([jobTitle, city])
  @@index([industry, experience])
}

model SalaryReport {
  id              String   @id @default(cuid())
  companyId       String
  employerId      String
  title           String
  reportType      String
  parameters      String
  p25Salary       Float?
  p50Salary       Float?
  p75Salary       Float?
  avgSalary       Float?
  percentileChart String?
  comparisonData  String?
  suggestions     String?
  status          String   @default("COMPLETED")
  createdAt       DateTime @default(now())

  company         Company  @relation(fields: [companyId], references: [id])
  generatedBy     Employer @relation(fields: [employerId], references: [id])

  @@index([companyId, reportType])
}

model JobFair {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  description  String?
  banner       String?
  type         String   @default("ONLINE")
  status       String   @default("UPCOMING")
  tags         String?
  categories   String?
  startDate    DateTime
  endDate      DateTime
  venue        String?
  city         String?
  maxBooths    Int      @default(50)
  totalBooths  Int      @default(0)
  totalJobs    Int      @default(0)
  totalApplicants Int   @default(0)
  totalCheckins Int     @default(0)
  createdAt    DateTime @default(now())

  company      Company  @relation(fields: [companyId], references: [id])
  booths       FairBooth[]
  checkIns     CheckInRecord[]

  @@index([companyId, status])
  @@index([type, startDate])
}

model FairBooth {
  id             String   @id @default(cuid())
  jobFairId      String
  companyId      String
  boothNumber    String
  boothName      String
  description    String?
  logo           String?
  banner         String?
  themeColor     String?
  layoutConfig   String?
  liveStreamId   String?
  status         String   @default("AVAILABLE")
  totalVisitors  Int      @default(0)
  totalResumes   Int      @default(0)
  sortOrder      Int      @default(0)

  jobFair        JobFair  @relation(fields: [jobFairId], references: [id])
  company        Company  @relation(fields: [companyId], references: [id])
  jobs           Job[]
  visitors       BoothVisitor[]
  resumes        ResumeCollection[]

  @@index([jobFairId, status])
  @@unique([jobFairId, boothNumber])
}

model BoothVisitor {
  id             String   @id @default(cuid())
  boothId        String
  visitorId      String
  visitorName    String?
  visitTime      DateTime @default(now())
  duration       Float    @default(0)
  viewedJobIds   String?
  downloadedDocs String?
  hasSharedResume Boolean @default(false)

  booth          FairBooth @relation(fields: [boothId], references: [id])

  @@index([boothId, visitorId])
}

model CheckInRecord {
  id           String   @id @default(cuid())
  jobFairId    String
  jobSeekerId  String
  checkInType  String
  qrCode       String?
  scannedBy    String?
  metadata     String?
  timestamp    DateTime @default(now())

  jobFair      JobFair  @relation(fields: [jobFairId], references: [id])
  jobSeeker    JobSeeker @relation(fields: [jobSeekerId], references: [id])

  @@index([jobFairId, timestamp])
  @@unique([jobFairId, jobSeekerId])
}

model ResumeCollection {
  id             String   @id @default(cuid())
  boothId        String
  jobId          String?
  jobSeekerId    String
  resumeId       String?
  resumeText     String?
  source         String   @default("BOOTH")
  collectedAt    DateTime @default(now())
  aiScreenScore  Float?
  aiScreenResult String?
  matchedJobIds  String?
  status         String   @default("NEW")

  booth          FairBooth @relation(fields: [boothId], references: [id])
  job            Job?     @relation(fields: [jobId], references: [id])

  @@index([boothId, status])
  @@index([status, aiScreenScore])
}

model CandidateProfile {
  id                  String   @id @default(cuid())
  jobSeekerId         String   @unique
  overallScore        Float    @default(0)
  level               String?
  careerLevel         String?
  industryTags        String?
  skillTags           String?
  communicationScore  Float?
  technicalScore      Float?
  experienceScore     Float?
  educationScore      Float?
  growthScore         Float?
  careerTrajectory    String?
  salaryExpectationBand String?
  preferredLocations  String?
  preferredIndustries String?
  preferredRoles      String?
  lastUpdated         DateTime @updatedAt

  jobSeeker           JobSeeker @relation(fields: [jobSeekerId], references: [id])
  dimensions          ProfileDimension[]
  behaviors           ProfileBehavior[]
  recommendations     JobRecommendation[]

  @@index([overallScore])
}

model ProfileDimension {
  id           String   @id @default(cuid())
  profileId    String
  dimension    String
  score        Float
  evidence     String?
  sources      String?
  lastUpdated  DateTime @updatedAt

  profile      CandidateProfile @relation(fields: [profileId], references: [id])

  @@index([profileId, dimension])
  @@unique([profileId, dimension])
}

model ProfileBehavior {
  id           String   @id @default(cuid())
  profileId    String
  actionType   String
  targetType   String
  targetId     String
  metadata     String?
  timestamp    DateTime @default(now())

  profile      CandidateProfile @relation(fields: [profileId], references: [id])

  @@index([profileId, actionType])
  @@index([timestamp])
}

model JobRecommendation {
  id           String   @id @default(cuid())
  profileId    String
  jobId        String
  score        Float
  matchReasons String?
  source       String   @default("AI")
  isViewed     Boolean  @default(false)
  isApplied    Boolean  @default(false)
  createdAt    DateTime @default(now())

  profile      CandidateProfile @relation(fields: [profileId], references: [id])
  job          Job      @relation(fields: [jobId], references: [id])

  @@index([profileId, score])
  @@unique([profileId, jobId])
}

model UserActivity {
  id        String   @id @default(cuid())
  userId    String
  action    String
  targetType String?
  targetId   String?
  metadata   String?
  createdAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, action])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  content   String?
  targetType String?
  targetId  String?
  metadata  String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([createdAt])
}

model AIScreeningTask {
  id              String   @id @default(cuid())
  jobId           String?
  resumeText      String?
  requirements    String?
  keywords        String?
  minExperience   Float?
  requiredCerts   String?
  status          String   @default("PENDING")
  result          String?
  overallScore    Float?
  keywordScore    Float?
  experienceScore Float?
  educationScore  Float?
  certScore       Float?
  skillScore      Float?
  matchedKeywords String?
  missingKeywords String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())

  job             Job?     @relation(fields: [jobId], references: [id])

  @@index([jobId, status])
  @@index([status, createdAt])
}
