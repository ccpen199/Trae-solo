# 短视频内容平台环境变量配置
# 复制此文件为 .env 并修改实际值

# ==================== 数据库配置 ====================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=video_platform
DB_USER=vp_admin
DB_PASSWORD=Vp_Admin_2024_Secure

# ==================== Redis配置 ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=Redis_Secure_2024_Pass

# ==================== RabbitMQ配置 ====================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=mq_admin
RABBITMQ_PASSWORD=Mq_Admin_2024_Secure

# ==================== MinIO配置 ====================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=Minio_Admin_2024_Secure
MINIO_BUCKET=videos

# ==================== JWT配置 ====================
JWT_SECRET=Video_Platform_JWT_Secret_2024_Very_Long_Key_For_Security
JWT_EXPIRES_IN=86400

# ==================== 服务端口配置 ====================
# API网关
API_GATEWAY_PORT=9876
# 用户服务
USER_SERVICE_PORT=9877
# 视频服务
VIDEO_SERVICE_PORT=9878
# 转码引擎
TRANSCODING_ENGINE_PORT=9879
# 推荐引擎
RECOMMEND_ENGINE_PORT=9880
# 安全引擎
SAFETY_ENGINE_PORT=9881
# 互动引擎
ENGAGEMENT_ENGINE_PORT=9882
# 广告服务
AD_SERVICE_PORT=9883
# 创作者前端
CREATOR_APP_PORT=9884
# 观众前端
VIEWER_APP_PORT=9885
# 审核前端
AUDITOR_APP_PORT=9886
# 广告主前端
ADVERTISER_APP_PORT=9887

# ==================== 服务URL配置 ====================
API_GATEWAY_URL=http://localhost:9876
USER_SERVICE_URL=http://localhost:9877
VIDEO_SERVICE_URL=http://localhost:9878
TRANSCODING_ENGINE_URL=http://localhost:9879
RECOMMEND_ENGINE_URL=http://localhost:9880
SAFETY_ENGINE_URL=http://localhost:9881
ENGAGEMENT_ENGINE_URL=http://localhost:9882
AD_SERVICE_URL=http://localhost:9883

# ==================== 环境配置 ====================
NODE_ENV=development
LOG_LEVEL=info
