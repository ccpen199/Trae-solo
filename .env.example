# ========================================
# QA Community System Environment Variables
# ========================================

# Server Configuration
PORT=8765
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://qa_admin:QaSecure2024!@localhost:27017/qa_community?authSource=admin
MONGODB_DB_NAME=qa_community

# Redis Configuration
REDIS_URL=redis://:RedisSecure2024!@localhost:6379
REDIS_PASSWORD=RedisSecure2024!

# RabbitMQ Configuration
RABBITMQ_URL=amqp://qa_mq_user:MqSecure2024!@localhost:5672/qa_vhost

# JWT Configuration
JWT_SECRET=QaCommunityJwtSecret2024VeryLongSecretKeyForProduction
JWT_EXPIRES_IN=24h

# CORS Configuration
CORS_ORIGIN=http://localhost:8766

# Logging
LOG_LEVEL=debug

# ========================================
# Expert Matching Engine
# ========================================
EXPERT_MATCH_MIN_SCORE=0.6
EXPERT_MATCH_MAX_EXPERTS=5

# ========================================
# Quality Credit Engine
# ========================================
CREDIT_BASE_SCORE=100
CREDIT_VOTE_WEIGHT=0.5
CREDIT_ANSWER_WEIGHT=2.0
CREDIT_ACCEPTED_WEIGHT=10.0

# ========================================
# Revenue Settlement Engine
# ========================================
SETTLEMENT_FEE_PERCENTAGE=0.1
SETTLEMENT_MIN_AMOUNT=10

# ========================================
# Frontend Configuration
# ========================================
VITE_API_BASE_URL=http://localhost:8765
VITE_PORT=8766
