  { key: 'peak', label: '峰值', icon: Gauge },
  { key: 'decline', label: '回落', icon: TrendingDown },
  { key: 'handle', label: '处置', icon: Shield },
  { key: 'closed', label: '结案', icon: CheckCircle },
];

const eventsWithEvolution = [
  {
    ...hotEvents[0],
