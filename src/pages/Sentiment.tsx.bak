];

const levelConfigs: Record<string, { label: string; color: string; bg: string; border: string }> = {
  red: { label: '红色预警', color: 'text-red-700', bg: 'bg-red-100', border: 'border-red-300' },
  orange: { label: '橙色预警', color: 'text-orange-700', bg: 'bg-orange-100', border: 'border-orange-300' },
  yellow: { label: '黄色预警', color: 'text-yellow-700', bg: 'bg-yellow-100', border: 'border-yellow-300' },
  blue: { label: '蓝色预警', color: 'text-blue-700', bg: 'bg-blue-100', border: 'border-blue-300' },
};

function HotEventsList({ onSelect }: { onSelect: (event: any) => void }) {
  const renderEventTimeline = (event: any) => {
    const currentStageIdx = eventEvolutionStages.findIndex(s => s.key === event.currentStage);
    return (
      <div className="flex items-start mt-3">
        {eventEvolutionStages.map((stage, idx) => {
          const StageIcon = stage.icon;
          const evoData = event.evolution.find((e: any) => e.stage === stage.key);
          const isDone = idx < currentStageIdx || (idx === currentStageIdx && ['handle', 'closed'].includes(stage.key) && evoData);
          const isCurrent = idx === currentStageIdx && !['closed'].includes(stage.key);
          const isPending = idx > currentStageIdx && !evoData;
          const isLast = idx === eventEvolutionStages.length - 1;

          let nodeColor = 'bg-slate-200 text-slate-400';
          let lineColor = 'bg-slate-200';
          if (isDone) {
            nodeColor = 'bg-green-500 text-white';
            lineColor = 'bg-green-500';
          }
          if (isCurrent) {
            nodeColor = 'bg-orange-500 text-white animate-pulse';
            lineColor = 'bg-orange-400';
          }

          return (
            <div key={stage.key} className="flex-1 flex flex-col items-center relative">
              <div className={`w-5 h-5 rounded-full flex items-center justify-center ${nodeColor} z-10`}>
                <StageIcon className="w-2.5 h-2.5" />
              </div>
              {!isLast && (
                <div 
                  className={`absolute top-2.5 left-1/2 w-full h-0.5 ${lineColor}`}
                  style={{ left: '50%', width: '100%' }}
                />
              )}
              <div className="mt-1 text-center">
                <div className={`text-[9px] font-medium ${
                  isDone ? 'text-green-600' : isCurrent ? 'text-orange-600' : 'text-slate-400'
                }`}>
                  {stage.label}
                </div>
                {evoData && (
                  <div className={`text-[8px] mt-0.5 ${isCurrent ? 'text-orange-500' : 'text-slate-400'}`}>
                    {evoData.time.split(' ')[0]}
                  </div>
                )}
              </div>
            </div>
          );
        })}
      </div>
    );
  };

  return (
    <div className="space-y-4">
      {eventsWithEvolution.map((event, index) => {
        const levelCfg = levelConfigs[event.currentLevel];
        return (
          <div 
            key={event.id} 
            onClick={() => onSelect(event)}
            className="bg-white rounded-xl p-5 border border-slate-200 shadow-sm hover:shadow-md hover:border-primary-300 transition-all cursor-pointer"
          >
            <div className="flex items-start gap-4 mb-3">
              <div className={`w-10 h-10 rounded-lg flex items-center justify-center text-lg font-bold flex-shrink-0 ${
                index < 3 ? 'bg-red-500 text-white' : 'bg-slate-100 text-slate-600'
              }`}>
                {index + 1}
              </div>
              <div className="flex-1 min-w-0">
                <div className="flex items-center gap-3 mb-2 flex-wrap">
                  <h3 className="font-semibold text-slate-800">{event.name}</h3>
                  <div className="flex items-center gap-2 flex-wrap">
                    <span className={`px-2 py-0.5 rounded-full text-[10px] font-medium border ${levelCfg.bg} ${levelCfg.color} ${levelCfg.border} flex items-center gap-0.5`}>
                      <AlertTriangle className="w-2.5 h-2.5" />
                      {levelCfg.label}
                    </span>
                    <span className={`px-2 py-0.5 rounded-full text-xs font-medium flex items-center gap-1 flex-shrink-0 ${
                      event.trend === 'up' ? 'bg-red-100 text-red-600' :
                      event.trend === 'down' ? 'bg-green-100 text-green-600' :
                      'bg-slate-100 text-slate-600'
                    }`}>
                      {event.trend === 'up' ? <TrendingUp className="w-3 h-3" /> :
                       event.trend === 'down' ? <TrendingDown className="w-3 h-3" /> :
                       <Minus className="w-3 h-3" />}
                      {event.trendValue > 0 ? '+' : ''}{event.trendValue}%
                    </span>
                  </div>
                </div>
                <div className="flex items-center gap-4 text-sm text-slate-500 mb-2 flex-wrap">
                  <span>热度：<span className="text-orange-500 font-medium">{(event.heat / 1000).toFixed(1)}k</span></span>
                  <span>相关报道：{event.articleCount}篇</span>
                  <span>更新于 {event.updateTime}</span>
                </div>
                <div className="flex flex-wrap gap-2">
                  {event.keywords.map(keyword => (
                    <span key={keyword} className="px-2 py-0.5 bg-blue-50 text-blue-600 rounded text-xs">
                      {keyword}
                    </span>
                  ))}
                </div>
              </div>
              <ChevronRight className="w-5 h-5 text-slate-300 flex-shrink-0 mt-1" />
            </div>

            {renderEventTimeline(event)}

            {event.evolution.length > 0 && (
              <div className="mt-4 pt-3 border-t border-slate-100">
                <div className="text-xs font-medium text-slate-600 mb-2 flex items-center gap-1">
                  <Clock className="w-3 h-3" />
                  演化时间线 · {event.evolution[event.evolution.length - 1].time}
                </div>
                <div className="bg-slate-50 rounded-lg p-2.5">
                  <div className="flex items-start gap-2">
                    <span className={`px-2 py-0.5 rounded text-[10px] font-medium flex-shrink-0 ${
                      event.evolution[event.evolution.length - 1].heat >= 8000 ? 'bg-red-100 text-red-600' :
                      event.evolution[event.evolution.length - 1].heat >= 4000 ? 'bg-orange-100 text-orange-600' :
                      'bg-green-100 text-green-600'
                    }`}>
                      热度 {(event.evolution[event.evolution.length - 1].heat / 1000).toFixed(1)}k
                    </span>
                    <p className="text-xs text-slate-600 line-clamp-1">
                      {event.evolution[event.evolution.length - 1].action}
                    </p>
                  </div>
                </div>
              </div>
            )}
          </div>
        );
      })}
    </div>
  );
}

interface SentimentListProps {
  searchText: string;
  setSearchText: (v: string) => void;
  filterSentiment: string;
  setFilterSentiment: (v: string) => void;
  filterPlatform: string;
  setFilterPlatform: (v: string) => void;
  filteredItems: typeof sentimentItems;
  selectedKeyword: string | null;
  setSelectedKeyword: (v: string | null) => void;
}

function SentimentList({
  searchText,
  setSearchText,
  filterSentiment,
  setFilterSentiment,
  filterPlatform,
  setFilterPlatform,
  filteredItems,
  selectedKeyword,
  setSelectedKeyword
}: SentimentListProps) {
  return (
    <div className="space-y-4">
      {selectedKeyword && (
        <div className="bg-primary-50 border border-primary-200 rounded-xl p-4 flex items-center justify-between">
          <div className="flex items-center gap-3">
            <div className="w-10 h-10 bg-primary-100 rounded-lg flex items-center justify-center">
              <Hash className="w-5 h-5 text-primary-600" />
            </div>
            <div>
              <div className="text-sm font-medium text-primary-700">关键词筛选中</div>
              <div className="flex items-center gap-2 mt-1">
                <span className="px-3 py-1 bg-primary-100 text-primary-700 rounded-full text-sm font-medium">
                  {selectedKeyword}
                </span>
                <span className="text-xs text-primary-600">
                  共 {filteredItems.length} 篇相关文章
                </span>
              </div>
            </div>
          </div>
          <button
            onClick={() => setSelectedKeyword(null)}
            className="p-2 bg-white hover:bg-primary-100 rounded-lg text-primary-600 transition-colors"
          >
            <X className="w-5 h-5" />
          </button>
        </div>
      )}

      <div className="flex flex-wrap items-center gap-3">
        <div className="relative flex-1 min-w-[200px]">
          <Search className="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" />
          <input
            type="text"
            value={searchText}
            onChange={(e) => setSearchText(e.target.value)}
            placeholder="搜索舆情内容..."
            className="w-full pl-10 pr-4 py-2 bg-white border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary-500"
          />
        </div>
        <select
          value={filterSentiment}
          onChange={(e) => setFilterSentiment(e.target.value)}
          className="px-3 py-2 bg-white border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary-500"
        >
          <option value="all">全部情感</option>
          <option value="positive">正面</option>
          <option value="negative">负面</option>
          <option value="neutral">中性</option>
        </select>
        <select
          value={filterPlatform}
          onChange={(e) => setFilterPlatform(e.target.value)}
          className="px-3 py-2 bg-white border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary-500"
        >
          <option value="all">全部平台</option>
          <option value="website">网站</option>
          <option value="weibo">微博</option>
          <option value="wechat">微信</option>
          <option value="douyin">抖音</option>
        </select>
      </div>

      <div className="space-y-3">
        {filteredItems.map((item) => {
          const sentimentInfo = {
            positive: { label: '正面', icon: ThumbsUp, color: SENTIMENT_COLORS.positive },
            negative: { label: '负面', icon: ThumbsDown, color: SENTIMENT_COLORS.negative },
            neutral: { label: '中性', icon: Minus, color: SENTIMENT_COLORS.neutral }
          }[item.sentiment];
          const SentimentIcon = sentimentInfo.icon;

          return (
            <div key={item.id} className="bg-white rounded-xl p-5 border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
              <div className="flex items-start gap-4">
                <div className="flex-1">
                  <div className="flex items-center gap-3 mb-2">
                    <h3 className="font-medium text-slate-800 hover:text-primary-600 cursor-pointer">
                      {item.title}
                    </h3>
                    <span className={`px-2 py-0.5 rounded-full text-xs font-medium flex items-center gap-1 ${sentimentInfo.color}`}>
                      <SentimentIcon className="w-3 h-3" />
                      {sentimentInfo.label}
                    </span>
                  </div>
                  <p className="text-sm text-slate-500 line-clamp-2 mb-3">{item.summary}</p>
                  <div className="flex items-center gap-4 text-xs text-slate-400">
                    <span className="flex items-center gap-1">
                      <Globe className="w-3 h-3" />
                      {item.source}
                    </span>
                    <span className="flex items-center gap-1">
                      <Clock className="w-3 h-3" />
                      {item.publishTime}
                    </span>
                    <span className="flex items-center gap-1">
                      <Zap className="w-3 h-3 text-orange-400" />
                      热度 {item.heat}
                    </span>
                    {item.region && (
                      <span className="flex items-center gap-1">
                        区域：{item.region}
                      </span>
                    )}
                  </div>
                  <div className="flex flex-wrap gap-1 mt-3">
                    {item.keywords.map((keyword) => (
                      <span key={keyword} className="px-2 py-0.5 bg-slate-100 text-slate-500 rounded text-xs">
                        {keyword}
                      </span>
                    ))}
                  </div>
                </div>
                <button className="text-primary-500 text-sm flex items-center gap-1">
                  <ExternalLink className="w-4 h-4" />
                </button>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  );
}

const reportFlowStages = [
  { key: 'generating', label: '生成中', icon: Sparkles },
  { key: 'pending_review', label: '待审核', icon: Eye },
  { key: 'reviewed', label: '审核通过', icon: CheckCircle },
  { key: 'pushed', label: '已推送', icon: Send },
  { key: 'signed', label: '已签收', icon: UserCheck },
];

const dailyReportsData = [
  {
    id: 'today',
    title: '昌平区每日舆情简报（2026年6月19日）',
    date: '2026-06-19',
