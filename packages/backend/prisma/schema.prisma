generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id             String   @id @default(cuid())
  subdomain      String   @unique
  name           String
  fullName       String?
  logo           String?
  description    String?
  status         String   @default("active")
  location       String?
  province       String?
  city           String?
  district       String?
  address        String?
  radiusKm       Float?
  propertyCompanyId String?
  samlConfig     String?
  settings       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users          User[]
  topics         Topic[]
  products       Product[]
  orders         Order[]
  warehouses     Warehouse[]
  pickupPoints   PickupPoint[]
  buildings      CommunityBuilding[]
  accessCards    AccessCard[]
  accessRecords  AccessRecord[]
  accessDevices  AccessControlDevice[]
  paymentBills   PaymentBill[]
  repairRequests RepairRequest[]
  complaints     Complaint[]
  notifications  PropertyNotification[]
  partners       Partner[]
  redPackets     RedPacket[]
  signInRecords  SignInRecord[]
  inviteRecords  InviteRecord[]
  secondhandListings SecondhandListing[]
  secondhandOrders   SecondhandOrder[]
  households          Household[]
  topicComments       TopicComment[]
  partnerSettlements  PartnerSettlement[]
  propertyApiConfigs PropertyApiConfig[]
  apiRequestLogs     ApiRequestLog[]

  @@map("tenants")
}

model PropertyCompany {
  id              String   @id @default(cuid())
  name            String
  contactName     String?
  contactPhone    String?
  contactEmail    String?
  address         String?
  businessLicense String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("property_companies")
}

model CommunityBuilding {
  id             String   @id @default(cuid())
  tenantId       String
  buildingNo     String
  unitNo         String?
  totalFloors    Int?
  totalHouseholds Int?
  createdAt      DateTime @default(now())

  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  households     Household[]

  @@map("community_buildings")
}

model User {
  id                  String   @id @default(cuid())
  tenantId            String
  phone               String
  email               String?
  nickname            String?
  avatar              String?
  realName            String?
  idCardType          String?
  idCardNumber        String?
  idCardFrontImage    String?
  idCardBackImage     String?
  faceImage           String?
  verificationStatus  String   @default("unverified")
  verificationRemark  String?
  status              String   @default("active")
  role                String   @default("resident")
  samlIdentityId      String?  @unique
  lastLoginAt         DateTime?
  lastLoginIp         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant              Tenant             @relation(fields: [tenantId], references: [id])
  profile             UserProfile?
  households          Household[]
  accessCards         AccessCard[]
  accessRecords       AccessRecord[]
  topics              Topic[]
  topicComments       TopicComment[]     @relation("UserComments")
  topicLikes          TopicLike[]        @relation("UserLikes")
  topicReports        TopicReport[]      @relation("UserReports")
  topicTraceLogs      TopicTraceLog[]    @relation("UserTraceLogs")
  orders              Order[]
  wallet              UserWallet?
  walletTransactions  WalletTransaction[]
  withdrawRecords     WithdrawRecord[]
  redPackets          RedPacket[]
  signInRecords       SignInRecord[]
  inviteRecordsSent   InviteRecord[]      @relation("Inviter")
  inviteRecordsRecv   InviteRecord[]      @relation("Invitee")
  userTaskRecords     UserTaskRecord[]
  secondhandListings  SecondhandListing[]
  secondhandOrdersBuyer SecondhandOrder[] @relation("Buyer")
  secondhandOrdersSeller SecondhandOrder[] @relation("Seller")
  secondhandFavorites SecondhandFavorite[] @relation("UserFavorites")
  partner             Partner?
  repairRequests      RepairRequest[]
  complaints          Complaint[]
  paymentBills        PaymentBill[]

  @@unique([tenantId, phone])
  @@map("users")
}

model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  gender    String?
  birthday  DateTime?
  signature String?
  tags      String?

  user      User     @relation(fields: [userId], references: [id])

  @@map("user_profiles")
}

model Household {
  id            String   @id @default(cuid())
  userId        String
  tenantId      String
  buildingId    String
  roomNo        String
  householdType String
  relationship  String?
  moveInDate    DateTime?
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())

  user          User               @relation(fields: [userId], references: [id])
  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  building      CommunityBuilding  @relation(fields: [buildingId], references: [id])

  @@map("households")
}

model AccessCard {
  id          String    @id @default(cuid())
  userId      String
  tenantId    String
  cardNumber  String    @unique
  cardType    String
  deviceId    String?
  deviceInfo  String?
  status      String    @default("active")
  validFrom   DateTime?
  validTo     DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id])
  tenant      Tenant    @relation(fields: [tenantId], references: [id])

  @@map("access_cards")
}

model AccessRecord {
  id           String   @id @default(cuid())
  userId       String
  tenantId     String
  cardId       String?
  deviceId     String
  deviceName   String?
  accessType   String
  accessPoint  String
  accessResult String
  accessMethod String
  remark       String?
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id])
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  @@map("access_records")
}

model AccessControlDevice {
  id              String    @id @default(cuid())
  tenantId        String
  deviceCode      String    @unique
  deviceName      String
  deviceType      String
  location        String
  status          String    @default("online")
  lastHeartbeat   DateTime?
  vendor          String?
  vendorDeviceId  String?

  tenant          Tenant    @relation(fields: [tenantId], references: [id])

  @@map("access_control_devices")
}

model Topic {
  id             String   @id @default(cuid())
  tenantId       String
  authorId       String
  category       String
  title          String
  content        String
  images         String?
  videos         String?
  location       String?
  locationName   String?
  tags           String?
  isAnonymous    Boolean  @default(false)
  isTop          Boolean  @default(false)
  isEssence      Boolean  @default(false)
  status         String   @default("published")
  viewCount      Int      @default(0)
  likeCount      Int      @default(0)
  commentCount   Int      @default(0)
  shareCount     Int      @default(0)
  reportCount    Int      @default(0)
  sensitiveScore Int?
  sensitiveWords String?
  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  author         User            @relation(fields: [authorId], references: [id])
  comments       TopicComment[]
  likes          TopicLike[]
  reports        TopicReport[]
  traceLogs      TopicTraceLog[]

  @@map("topics")
}

model TopicComment {
  id            String   @id @default(cuid())
  topicId       String
  tenantId      String
  authorId      String
  parentId      String?
  replyToUserId String?
  content       String
  images        String?
  likeCount     Int      @default(0)
  isAnonymous   Boolean  @default(false)
  status        String   @default("normal")
  sensitiveScore Int?
  createdAt     DateTime @default(now())

  topic         Topic    @relation(fields: [topicId], references: [id])
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  author        User     @relation("UserComments", fields: [authorId], references: [id])

  @@map("topic_comments")
}

model TopicLike {
  id        String   @id @default(cuid())
  topicId   String
  userId    String
  createdAt DateTime @default(now())

  topic     Topic    @relation(fields: [topicId], references: [id])
  user      User     @relation("UserLikes", fields: [userId], references: [id])

  @@unique([topicId, userId])
  @@map("topic_likes")
}

model TopicReport {
  id             String    @id @default(cuid())
  topicId        String
  reporterId     String
  reason         String
  description    String?
  evidenceImages String?
  status         String    @default("pending")
  handlerId      String?
  handleRemark   String?
  handledAt      DateTime?
  createdAt      DateTime  @default(now())

  topic          Topic     @relation(fields: [topicId], references: [id])
  reporter       User      @relation("UserReports", fields: [reporterId], references: [id])

  @@map("topic_reports")
}

model TopicTraceLog {
  id            String   @id @default(cuid())
  topicId       String
  userId        String
  action        String
  beforeContent String?
  afterContent  String?
  ip            String?
  metadata      String?
  createdAt     DateTime @default(now())

  topic         Topic    @relation(fields: [topicId], references: [id])
  user          User     @relation("UserTraceLogs", fields: [userId], references: [id])

  @@map("topic_trace_logs")
}

model ProductCategory {
  id        String  @id @default(cuid())
  tenantId  String?
  parentId  String?
  name      String
  icon      String?
  sortOrder Int     @default(0)
  level     Int     @default(0)
  isActive  Boolean @default(true)

  @@map("product_categories")
}

model Product {
  id               String   @id @default(cuid())
  tenantId         String
  categoryId       String
  productType      String
  partnerId        String?
  name             String
  subtitle         String?
  description      String
  images           String
  mainImage        String
  price            Float
  originalPrice    Float?
  costPrice        Float?
  stock            Int      @default(0)
  soldCount        Int      @default(0)
  unit             String   @default("件")
  weight           Float?
  isFreeShipping   Boolean  @default(true)
  shippingFee      Float?
  deliveryRadiusKm Float?
  deliveryTypes    String
  pickupPoints     String?
  status           String   @default("on_sale")
  tags             String?
  sortOrder        Int      @default(0)
  isRecommend      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant           Tenant       @relation(fields: [tenantId], references: [id])
  skus             ProductSku[]

  @@map("products")
}

model ProductSku {
  id            String  @id @default(cuid())
  productId     String
  skuCode       String
  specs         String
  price         Float
  originalPrice Float?
  costPrice     Float?
  stock         Int     @default(0)
  image         String?
  status        String  @default("active")

  product       Product @relation(fields: [productId], references: [id])

  @@map("product_skus")
}

model Warehouse {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  code        String
  location    String
  address     String
  contactName String?
  contactPhone String?
  type        String
  status      String   @default("active")
  createdAt   DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@map("warehouses")
}

model PickupPoint {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  buildingId   String?
  address      String
  location     String?
  contactName  String?
  contactPhone String?
  businessHours String?
  status       String   @default("active")
  createdAt    DateTime @default(now())

  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  @@map("pickup_points")
}

model InventoryRecord {
  id             String   @id @default(cuid())
  warehouseId    String?
  pickupPointId  String?
  productId      String
  skuId          String?
  quantity       Int
  changeType     String
  relatedOrderId String?
  remark         String?
  operatorId     String?
  createdAt      DateTime @default(now())

  @@map("inventory_records")
}

model Order {
  id               String    @id @default(cuid())
  orderNo          String    @unique
  tenantId         String
  userId           String
  orderType        String
  totalAmount      Float
  discountAmount   Float     @default(0)
  shippingFee      Float     @default(0)
  redpacketAmount  Float     @default(0)
  payAmount        Float
  paymentMethod    String?
  paymentStatus    String    @default("unpaid")
  paidAt           DateTime?
  status           String    @default("pending_payment")
  remark           String?
  deliveryType     String
  pickupPointId    String?
  deliveryAddressId String?
  deliveryAddress  String?
  trackingNo       String?
  trackingCompany  String?
  completedAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant           Tenant          @relation(fields: [tenantId], references: [id])
  user             User            @relation(fields: [userId], references: [id])
  items            OrderItem[]
  payments         PaymentRecord[]
  refunds          Refund[]

  @@map("orders")
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String
  skuId        String?
  productName  String
  productImage String
  specs        String?
  quantity     Int
  unitPrice    Float
  amount       Float

  order        Order   @relation(fields: [orderId], references: [id])

  @@map("order_items")
}

model PaymentRecord {
  id                String    @id @default(cuid())
  orderId           String
  userId            String
  amount            Float
  method            String
  status            String
  transactionId     String?
  thirdPartyTradeNo String?
  paidAt            DateTime?
  metadata          String?
  createdAt         DateTime  @default(now())

  order             Order     @relation(fields: [orderId], references: [id])

  @@map("payment_records")
}

model Refund {
  id                   String    @id @default(cuid())
  orderId              String
  userId               String
  amount               Float
  reason               String
  description          String?
  evidenceImages       String?
  status               String    @default("pending")
  handlerId            String?
  handleRemark         String?
  refundTransactionId  String?
  refundedAt           DateTime?
  createdAt            DateTime  @default(now())

  order                Order     @relation(fields: [orderId], references: [id])

  @@map("refunds")
}

model RedPacket {
  id             String    @id @default(cuid())
  userId         String
  tenantId       String
  source         String
  sourceId       String?
  amount         Float
  remainingAmount Float
  minOrderAmount Float?
  status         String    @default("unused")
  expireAt       DateTime?
  usedAt         DateTime?
  usedOrderId    String?
  description    String?
  createdAt      DateTime  @default(now())

  user           User      @relation(fields: [userId], references: [id])
  tenant         Tenant    @relation(fields: [tenantId], references: [id])

  @@map("red_packets")
}

model UserWallet {
  id             String   @id @default(cuid())
  userId         String   @unique
  tenantId       String
  balance        Float    @default(0)
  frozenAmount   Float    @default(0)
  totalIncome    Float    @default(0)
  totalWithdraw  Float    @default(0)
  totalRedPacket Float    @default(0)
  updatedAt      DateTime @updatedAt

  user           User              @relation(fields: [userId], references: [id])
  transactions   WalletTransaction[]
  withdrawRecords WithdrawRecord[]

  @@map("user_wallets")
}

model WalletTransaction {
  id           String   @id @default(cuid())
  walletId     String
  userId       String
  amount       Float
  balanceAfter Float
  type         String
  source       String
  sourceId     String?
  description  String
  createdAt    DateTime @default(now())

  wallet       UserWallet @relation(fields: [walletId], references: [id])
  user         User       @relation(fields: [userId], references: [id])

  @@map("wallet_transactions")
}

model WithdrawRecord {
  id                String    @id @default(cuid())
  userId            String
  walletId          String
  tenantId          String
  amount            Float
  fee               Float     @default(0)
  actualAmount      Float
  status            String    @default("pending")
  paymentMethod     String
  paymentAccount    String
  paymentAccountName String?
  bankName          String?
  transactionId     String?
  auditorId         String?
  auditRemark       String?
  auditedAt         DateTime?
  completedAt       DateTime?
  rejectReason      String?
  riskFlag          Boolean   @default(false)
  riskReason        String?
  amlCheckPassed    Boolean?
  createdAt         DateTime  @default(now())

  user              User      @relation(fields: [userId], references: [id])
  wallet            UserWallet @relation(fields: [walletId], references: [id])

  @@map("withdraw_records")
}

model TaskDefinition {
  id            String    @id @default(cuid())
  tenantId      String?
  taskType      String
  name         String
  description  String
  rewardAmount Float
  rewardType   String
  maxDailyCount Int?
  maxTotalCount Int?
  startAt      DateTime?
  endAt        DateTime?
  isActive     Boolean   @default(true)
  conditions   String?

  @@map("task_definitions")
}

model UserTaskRecord {
  id             String    @id @default(cuid())
  userId         String
  taskId         String
  taskType       String
  completed      Boolean   @default(false)
  completedAt    DateTime?
  rewardGranted  Boolean   @default(false)
  rewardGrantedAt DateTime?
  metadata       String?
  createdAt      DateTime  @default(now())

  user           User      @relation(fields: [userId], references: [id])

  @@map("user_task_records")
}

model SignInRecord {
  id             String   @id @default(cuid())
  userId         String
  tenantId       String
  signInDate     String
  continuousDays Int
  rewardAmount   Float
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id])
  tenant         Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([userId, signInDate])
  @@map("sign_in_records")
}

model InviteRecord {
  id             String    @id @default(cuid())
  inviterId      String
  inviteeId      String
  tenantId       String
  rewardAmount   Float
  rewardGranted  Boolean   @default(false)
  rewardGrantedAt DateTime?
  createdAt      DateTime  @default(now())

  inviter        User      @relation("Inviter", fields: [inviterId], references: [id])
  invitee        User      @relation("Invitee", fields: [inviteeId], references: [id])
  tenant         Tenant    @relation(fields: [tenantId], references: [id])

  @@map("invite_records")
}

model SecondhandListing {
  id             String   @id @default(cuid())
  tenantId       String
  sellerId       String
  title          String
  description    String
  category       String
  price          Float
  originalPrice  Float?
  condition      String
  images         String
  location       String?
  locationName   String?
  allowDelivery  Boolean  @default(false)
  allowMeetup    Boolean  @default(true)
  meetupLocation String?
  tags           String?
  status         String   @default("on_sale")
  viewCount      Int      @default(0)
  favoriteCount  Int      @default(0)
  reportCount    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant         Tenant             @relation(fields: [tenantId], references: [id])
  seller         User               @relation(fields: [sellerId], references: [id])
  favorites      SecondhandFavorite[]

  @@map("secondhand_listings")
}

model SecondhandOrder {
  id                   String    @id @default(cuid())
  orderNo              String    @unique
  tenantId             String
  listingId            String
  buyerId              String
  sellerId             String
  price                Float
  serviceFee           Float     @default(0)
  totalAmount          Float
  sellerReceiveAmount  Float
  paymentMethod        String
  paymentStatus        String    @default("unpaid")
  status               String    @default("pending_payment")
  transactionId        String?
  paidAt               DateTime?
  escrowReleasedAt     DateTime?
  deliveryType         String
  buyerNotes           String?
  sellerNotes          String?
  disputeReason        String?
  disputeHandlerId     String?
  disputeResolution    String?
  completedAt          DateTime?
  cancelledAt          DateTime?
  cancelReason         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant               Tenant             @relation(fields: [tenantId], references: [id])
  buyer                User               @relation("Buyer", fields: [buyerId], references: [id])
  seller               User               @relation("Seller", fields: [sellerId], references: [id])
  escrowTransactions   EscrowTransaction[]

  @@map("secondhand_orders")
}

model SecondhandFavorite {
  id        String   @id @default(cuid())
  listingId String
  userId    String
  createdAt DateTime @default(now())

  listing   SecondhandListing @relation(fields: [listingId], references: [id])
  user      User              @relation("UserFavorites", fields: [userId], references: [id])

  @@unique([listingId, userId])
  @@map("secondhand_favorites")
}

model EscrowTransaction {
  id            String   @id @default(cuid())
  orderId       String
  type          String
  amount        Float
  fromAccount   String
  toAccount     String
  transactionId String?
  status        String   @default("pending")
  operatorId    String?
  remark        String?
  createdAt     DateTime @default(now())

  order         SecondhandOrder @relation(fields: [orderId], references: [id])

  @@map("escrow_transactions")
}

model Partner {
  id                    String    @id @default(cuid())
  userId                String    @unique
  tenantId              String
  partnerCode           String    @unique
  storeName             String?
  storeLogo             String?
  storeDescription      String?
  level                 String    @default("bronze")
  status                String    @default("pending")
  inviterId             String?
  invitePath            String    @default("")
  totalInvited          Int       @default(0)
  totalSales            Float     @default(0)
  totalCommission       Float     @default(0)
  withdrawableCommission Float    @default(0)
  frozenCommission      Float     @default(0)
  settledCommission     Float     @default(0)
  joinedAt              DateTime  @default(now())
  statusChangedAt       DateTime?
  idCardVerified        Boolean   @default(false)
  businessLicense       String?

  user                  User      @relation(fields: [userId], references: [id])
  tenant                Tenant    @relation(fields: [tenantId], references: [id])
  store                 PartnerStore?
  commissionRecords     CommissionRecord[]
  settlements           PartnerSettlement[]
  inviteRelationsAncestor   PartnerInviteRelation[] @relation("Ancestor")
  inviteRelationsDescendant PartnerInviteRelation[] @relation("Descendant")

  @@map("partners")
}

model PartnerInviteRelation {
  id           String   @id @default(cuid())
  tenantId     String
  ancestorId   String
  descendantId String
  depth        Int
  createdAt    DateTime @default(now())

  ancestor     Partner  @relation("Ancestor", fields: [ancestorId], references: [id])
  descendant   Partner  @relation("Descendant", fields: [descendantId], references: [id])

  @@map("partner_invite_relations")
}

model PartnerStore {
  id          String   @id @default(cuid())
  partnerId   String   @unique
  tenantId    String
  name        String
  description String?
  logo        String?
  banners     String?
  category    String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  partner     Partner  @relation(fields: [partnerId], references: [id])

  @@map("partner_stores")
}

model CommissionRecord {
  id               String    @id @default(cuid())
  partnerId        String
  orderId          String
  orderItemId      String?
  fromPartnerId    String?
  depth            Int       @default(0)
  orderAmount      Float
  commissionRate   Float
  commissionAmount Float
  status           String    @default("pending")
  availableAt      DateTime?
  settledAt        DateTime?
  createdAt        DateTime  @default(now())

  partner          Partner   @relation(fields: [partnerId], references: [id])

  @@map("commission_records")
}

model PartnerSettlement {
  id              String    @id @default(cuid())
  partnerId       String
  tenantId        String
  settlementNo    String    @unique
  periodStart     DateTime
  periodEnd       DateTime
  totalSales      Float
  totalCommission Float
  deductionAmount Float     @default(0)
  netAmount       Float
  status          String    @default("pending")
  paidAt          DateTime?
  transactionId   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  partner         Partner   @relation(fields: [partnerId], references: [id])
  tenant          Tenant    @relation(fields: [tenantId], references: [id])

  @@map("partner_settlements")
}

model PropertyApiConfig {
  id            String   @id @default(cuid())
  tenantId      String
  serviceType   String
  providerName  String
  baseUrl       String
  apiKey        String?
  apiSecret     String?
  accessToken   String?
  tokenExpiresAt DateTime?
  isActive      Boolean  @default(true)
  config        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id])

  @@map("property_api_configs")
}

model ApiRequestLog {
  id              String   @id @default(cuid())
  tenantId        String
  serviceType     String
  endpoint        String
  method          String
  requestBody     String?
  responseBody    String?
  statusCode      Int
  responseTimeMs  Int
  success         Boolean
  errorMessage    String?
  createdAt       DateTime @default(now())

  tenant          Tenant   @relation(fields: [tenantId], references: [id])

  @@map("api_request_logs")
}

model PaymentBill {
  id              String   @id @default(cuid())
  billNo          String   @unique
  tenantId        String
  userId          String
  householdId     String
  billType        String
  title           String
  totalAmount     Float
  paidAmount      Float    @default(0)
  unpaidAmount    Float
  status          String   @default("unpaid")
  billMonth       String?
  dueDate         DateTime?
  paidAt          DateTime?
  thirdPartyBillNo String?
  detail          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  user            User     @relation(fields: [userId], references: [id])

  @@map("payment_bills")
}

model RepairRequest {
  id              String    @id @default(cuid())
  orderNo         String    @unique
  tenantId        String
  userId          String
  householdId     String
  title           String
  description     String
  images          String?
  category        String
  priority        String    @default("normal")
  status          String    @default("submitted")
  assigneeId      String?
  assigneeName    String?
  appointmentTime DateTime?
  completedAt     DateTime?
  rating          Int?
  feedback        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  user            User      @relation(fields: [userId], references: [id])

  @@map("repair_requests")
}

model Complaint {
  id                      String    @id @default(cuid())
  orderNo                 String    @unique
  tenantId                String
  userId                  String
  category                String
  title                   String
  description             String
  images                  String?
  status                  String    @default("submitted")
  handlerId               String?
  handlerName             String?
  firstResponseAt         DateTime?
  firstResponseDurationMin Int?
  resolvedAt              DateTime?
  resolutionDurationMin   Int?
  resolution              String?
  rating                  Int?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  tenant                  Tenant    @relation(fields: [tenantId], references: [id])
  user                    User      @relation(fields: [userId], references: [id])

  @@map("complaints")
}

model PropertyNotification {
  id             String    @id @default(cuid())
  tenantId       String
  title          String
  content        String
  type           String    @default("notice")
  targetAudience String    @default("all")
  targetIds      String?
  isTop          Boolean   @default(false)
  publishedAt    DateTime?
  publisherId    String?
  createdAt      DateTime  @default(now())

  tenant         Tenant    @relation(fields: [tenantId], references: [id])

  @@map("property_notifications")
}

model RiskAlert {
  id           String    @id @default(cuid())
  type         String
  severity     String
  tenantId     String?
  userId       String?
  relatedId    String?
  title        String
  description  String
  data         String?
  isHandled    Boolean   @default(false)
  handlerId    String?
  handledAt    DateTime?
  handleRemark String?
  createdAt    DateTime  @default(now())

  @@map("risk_alerts")
}

model SensitiveWordHitLog {
  id            String   @id @default(cuid())
  topicId       String?
  commentId     String?
  userId        String
  matchedWords  String
  contentSnippet String
  riskScore     Int
  isBlocked     Boolean  @default(false)
  reviewedBy    String?
  reviewResult  String?
  createdAt     DateTime @default(now())

  @@map("sensitive_word_hit_logs")
}
