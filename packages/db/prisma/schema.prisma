generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  MERCHANT
  DOCTOR
  ADMIN
  SUPER_ADMIN
}

enum UserGender {
  MALE
  FEMALE
  UNKNOWN
}

enum UserStatus {
  ACTIVE
  DISABLED
  BANNED
}

enum PetType {
  CAT
  DOG
  FISH
  BIRD
  HAMSTER
  RABBIT
  REPTILE
  OTHER
}

enum PetGender {
  MALE
  FEMALE
  UNKNOWN
}

enum ProductStatus {
  DRAFT
  PENDING
  ON_SALE
  OFF_SALE
  REJECTED
}

enum OrderStatus {
  PENDING_PAYMENT
  PENDING_CONFIRM
  PENDING_SHIPMENT
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDING
  REFUNDED
}

enum PaymentMethod {
  ALIPAY
  WECHAT
  BALANCE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ShippingStatus {
  PENDING
  SHIPPED
  IN_TRANSIT
  DELIVERED
  FAILED
}

enum MembershipLevel {
  NORMAL
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

enum MembershipCardType {
  MONTHLY
  QUARTERLY
  YEARLY
  LIFETIME
}

enum FlashSaleStatus {
  DRAFT
  PENDING
  ACTIVE
  ENDED
  CANCELLED
}

enum TrialStatus {
  PENDING
  APPROVED
  REJECTED
  SHIPPED
  DELIVERED
  REVIEWED
  COMPLETED
  EXPIRED
}

enum PostType {
  DISCUSSION
  QUESTION
  REVIEW
  ADOPTION
  RESCUE
  MOMENT
}

enum PostStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  REMOVED
}

enum ContentAuditStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum DoctorStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  SUSPENDED
}

enum ConsultationStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum AdoptionStatus {
  OPEN
  PENDING
  ADOPTED
  CLOSED
  CANCELLED
}

enum RelationshipType {
  FOLLOW
  BLOCK
  FRIEND
}

enum ActivityType {
  LIKE
  COMMENT
  SHARE
  FOLLOW
  MENTION
  SYSTEM
}

enum ActivityParticipationStatus {
  NOT_PARTICIPATED
  PARTICIPATED
  WON
  PRIZE_SENT
  PRIZE_RECEIVED
}

enum MerchantStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  CLOSED
}

model User {
  id                String          @id @default(uuid())
  phone             String          @unique
  email             String?         @unique
  password          String
  nickname          String
  avatar            String?
  gender            UserGender      @default(UNKNOWN)
  birthday          DateTime?
  role              UserRole        @default(CUSTOMER)
  membershipLevel   MembershipLevel @default(NORMAL)
  membershipExpireAt DateTime?
  growthPoints      Int             @default(0)
  balance           Decimal         @default(0) @db.Decimal(12, 2)
  point             Int             @default(0)
  isVerified        Boolean         @default(false)
  status            UserStatus      @default(ACTIVE)
  lastLoginAt       DateTime?
  lastLoginIp       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  pets              PetProfile[]
  addresses         UserAddress[]
  orders            Order[]
  carts             CartItem[]
  coupons           UserCoupon[]
  reviews           ProductReview[]
  posts             Post[]
  comments          Comment[]
  likes             Like[]
  relationships     UserRelationship[] @relation("follower")
  following         UserRelationship[] @relation("following")
  activities        Activity[]
  behaviorLogs      UserBehaviorLog[]
  userTags          UserProfileTag[]
  merchant          Merchant?
  doctor            DoctorProfile?
  membershipPurchases MembershipPurchase[]
  trialApplications TrialApplication[]
  reviewHelpfulVotes ReviewHelpful[]
  topicFollowers    TopicFollower[]
  shares            Share[]
  consultationOrders ConsultationOrder[]
  adoptionPosts     AdoptionPost[]
  adoptionApplications AdoptionApplication[]
  activityParticipations ActivityParticipation[]

  @@index([phone])
  @@index([role])
  @@index([status])
  @@index([membershipLevel])
}

model PetProfile {
  id              String          @id @default(uuid())
  userId          String
  name            String
  type            PetType
  breed           String?
  gender          PetGender       @default(UNKNOWN)
  birthday        DateTime?
  weight          Decimal?        @db.Decimal(6, 2)
  avatar          String?
  bio             String?
  isNeutered      Boolean         @default(false)
  tags            String[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  vaccineRecords  PetVaccineRecord[]
  healthRecords   PetHealthRecord[]
  petTags         PetProfileTag[]
  trials          TrialApplication[]
  consultations   ConsultationOrder[]

  @@index([userId])
  @@index([type])
}

model PetVaccineRecord {
  id               String   @id @default(uuid())
  petId            String
  vaccineName      String
  vaccineDate      DateTime
  nextVaccineDate  DateTime?
  hospitalName     String?
  certificateImage String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  pet              PetProfile @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId])
}

model PetHealthRecord {
  id         String                         @id @default(uuid())
  petId      String
  recordType String
  recordDate DateTime
  hospitalName String?
  doctorName String?
  diagnosis  String?
  prescription String?
  images     String[]
  notes      String?
  createdAt  DateTime                       @default(now())
  updatedAt  DateTime                       @updatedAt

  pet        PetProfile                     @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId])
}

model UserAddress {
  id         String   @id @default(uuid())
  userId     String
  name       String
  phone      String
  province   String
  city       String
  district   String
  detail     String
  postalCode String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ProductCategory {
  id        String            @id @default(uuid())
  name      String
  code      String            @unique
  icon      String?
  level     Int
  parentId  String?
  sortOrder Int               @default(0)
  status    Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  parent    ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  ProductCategory[] @relation("CategoryTree")
  products  ProductSPU[]

  @@index([parentId])
  @@index([code])
  @@index([level])
}

model ProductAttribute {
  id         String   @id @default(uuid())
  name       String
  values     Json
  isVariant  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  spuId      String
  spu        ProductSPU @relation(fields: [spuId], references: [id], onDelete: Cascade)
}

model ProductSPU {
  id           String         @id @default(uuid())
  merchantId   String
  categoryId   String
  name         String
  subtitle     String?
  description  String
  mainImage    String
  images       String[]
  videos       String[]
  status       ProductStatus  @default(DRAFT)
  salesCount   Int            @default(0)
  reviewCount  Int            @default(0)
  rating       Decimal        @default(0) @db.Decimal(3, 2)
  auditReason  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  merchant     Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  category     ProductCategory @relation(fields: [categoryId], references: [id])
  attributes   ProductAttribute[]
  skus         ProductSKU[]
  flashSaleItems FlashSaleItem[]
  trialItems   ProductTrial[]
  reviews      ProductReview[]
  orderItems   OrderItem[]

  @@index([merchantId])
  @@index([categoryId])
  @@index([status])
  @@index([salesCount(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model ProductSKU {
  id          String   @id @default(uuid())
  spuId       String
  skuCode     String   @unique
  attributes  Json
  price       Decimal  @db.Decimal(12, 2)
  originalPrice Decimal @db.Decimal(12, 2)
  cost        Decimal  @db.Decimal(12, 2)
  stock       Int      @default(0)
  stockLocked Int      @default(0)
  weight      Decimal  @default(0) @db.Decimal(8, 2)
  barcode     String?
  image       String?
  status      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  spu         ProductSPU @relation(fields: [spuId], references: [id], onDelete: Cascade)
  cartItems   CartItem[]
  flashSaleItems FlashSaleItem[]
  orderItems  OrderItem[]
  reviews     ProductReview[]

  @@index([spuId])
  @@index([skuCode])
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String
  skuId     String
  quantity  Int      @default(1)
  selected  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sku       ProductSKU @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@unique([userId, skuId])
  @@index([userId])
}

model Order {
  id              String          @id @default(uuid())
  orderNo         String          @unique
  userId          String
  merchantId      String
  status          OrderStatus     @default(PENDING_PAYMENT)
  totalAmount     Decimal         @db.Decimal(12, 2)
  discountAmount  Decimal         @default(0) @db.Decimal(12, 2)
  shippingFee     Decimal         @default(0) @db.Decimal(12, 2)
  actualAmount    Decimal         @db.Decimal(12, 2)
  pointUsed       Int             @default(0)
  pointEarned     Int             @default(0)
  paymentMethod   PaymentMethod?
  paymentStatus   PaymentStatus   @default(PENDING)
  paidAt          DateTime?
  shippingStatus  ShippingStatus  @default(PENDING)
  trackingNo      String?
  trackingCompany String?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  shippingAddress Json
  invoiceInfo     Json?
  remark          String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user            User            @relation(fields: [userId], references: [id])
  merchant        Merchant        @relation(fields: [merchantId], references: [id])
  items           OrderItem[]
  paymentRecords  PaymentRecord[]
  shippingLogs    ShippingLog[]
  couponUsed      UserCoupon?     @relation(fields: [couponId], references: [id])
  couponId        String?         @unique

  @@index([userId])
  @@index([merchantId])
  @@index([orderNo])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  skuId        String
  spuId        String
  productName  String
  productImage String
  attributes   Json
  price        Decimal  @db.Decimal(12, 2)
  quantity     Int
  subtotal     Decimal  @db.Decimal(12, 2)
  isReviewed   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku          ProductSKU   @relation(fields: [skuId], references: [id])
  spu          ProductSPU   @relation(fields: [spuId], references: [id])
  review       ProductReview?

  @@index([orderId])
  @@index([skuId])
}

model PaymentRecord {
  id             String        @id @default(uuid())
  orderId        String
  paymentNo      String        @unique
  method         PaymentMethod
  amount         Decimal       @db.Decimal(12, 2)
  status         PaymentStatus @default(PENDING)
  transactionId  String?
  paidAt         DateTime?
  failedReason   String?
  refundAmount   Decimal?      @db.Decimal(12, 2)
  refundAt       DateTime?
  refundReason   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([paymentNo])
}

model ShippingLog {
  id              String   @id @default(uuid())
  orderId         String
  trackingNo      String
  trackingCompany String
  status          String
  location        String?
  description     String
  eventTime       DateTime
  createdAt       DateTime @default(now())

  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([trackingNo])
}

model FlashSale {
  id          String          @id @default(uuid())
  title       String
  description String?
  bannerImage String?
  startTime   DateTime
  endTime     DateTime
  status      FlashSaleStatus @default(DRAFT)
  totalStock  Int             @default(0)
  soldCount   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  items       FlashSaleItem[]

  @@index([status])
  @@index([startTime, endTime])
}

model FlashSaleItem {
  id           String   @id @default(uuid())
  flashSaleId  String
  skuId        String
  spuId        String
  salePrice    Decimal  @db.Decimal(12, 2)
  originalPrice Decimal @db.Decimal(12, 2)
  saleStock    Int
  soldCount    Int      @default(0)
  limitPerUser Int      @default(1)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  flashSale    FlashSale  @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  sku          ProductSKU @relation(fields: [skuId], references: [id])
  spu          ProductSPU @relation(fields: [spuId], references: [id])

  @@index([flashSaleId])
  @@index([skuId])
}

model CouponTemplate {
  id              String   @id @default(uuid())
  name            String
  type            String
  value           Decimal  @db.Decimal(12, 2)
  minAmount       Decimal  @default(0) @db.Decimal(12, 2)
  maxDiscount     Decimal? @db.Decimal(12, 2)
  scope           String   @default("all")
  scopeIds        String[]
  durationType    String
  durationDays    Int?
  validFrom       DateTime?
  validTo         DateTime?
  totalQuantity   Int
  receivedCount   Int      @default(0)
  usedCount       Int      @default(0)
  perUserLimit    Int      @default(1)
  status          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  userCoupons     UserCoupon[]

  @@index([status])
  @@index([validFrom, validTo])
}

model UserCoupon {
  id         String          @id @default(uuid())
  userId     String
  templateId String
  code       String          @unique
  status     String          @default("unused")
  receivedAt DateTime        @default(now())
  validFrom  DateTime
  validTo    DateTime
  usedAt     DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  template   CouponTemplate  @relation(fields: [templateId], references: [id])
  order      Order?

  @@index([userId])
  @@index([templateId])
  @@index([status])
}

model MembershipCard {
  id           String              @id @default(uuid())
  type         MembershipCardType
  name         String
  price        Decimal             @db.Decimal(12, 2)
  originalPrice Decimal            @db.Decimal(12, 2)
  durationDays Int
  benefits     Json
  gifts        Json
  isHot        Boolean             @default(false)
  sortOrder    Int                 @default(0)
  status       Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  purchases    MembershipPurchase[]
}

model MembershipPurchase {
  id        String           @id @default(uuid())
  userId    String
  cardId    String
  orderNo   String
  amount    Decimal          @db.Decimal(12, 2)
  paidAt    DateTime
  startDate DateTime
  endDate   DateTime
  status    String           @default("active")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user      User             @relation(fields: [userId], references: [id])
  card      MembershipCard   @relation(fields: [cardId], references: [id])

  @@index([userId])
  @@index([cardId])
}

model ProductTrial {
  id                    String       @id @default(uuid())
  spuId                 String
  title                 String
  description           String
  coverImage            String
  totalQuantity         Int
  appliedCount          Int          @default(0)
  approvedCount         Int          @default(0)
  applicationStartTime  DateTime
  applicationEndTime    DateTime
  trialDurationDays     Int
  reviewDeadline        DateTime
  status                TrialStatus  @default(PENDING)
  requirements          String[]
  tags                  String[]
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  spu                   ProductSPU   @relation(fields: [spuId], references: [id])
  applications          TrialApplication[]

  @@index([spuId])
  @@index([status])
}

model TrialApplication {
  id              String      @id @default(uuid())
  trialId         String
  userId          String
  petId           String?
  reason          String
  experience      String?
  status          TrialStatus @default(PENDING)
  approvedAt      DateTime?
  rejectedReason  String?
  shippedAt       DateTime?
  trackingNo      String?
  trackingCompany String?
  deliveredAt     DateTime?
  reviewId        String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  trial           ProductTrial @relation(fields: [trialId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id])
  pet             PetProfile?  @relation(fields: [petId], references: [id])
  review          ProductReview? @relation(fields: [reviewId], references: [id])

  @@index([trialId])
  @@index([userId])
  @@index([status])
}

model ProductReview {
  id           String       @id @default(uuid())
  orderItemId  String       @unique
  userId       String
  spuId        String
  skuId        String
  rating       Int
  content      String
  images       String[]
  videos       String[]
  gifs         String[]
  isTrial      Boolean      @default(false)
  status       ReviewStatus @default(PENDING)
  helpfulCount Int          @default(0)
  replyContent String?
  replyAt      DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  orderItem    OrderItem    @relation(fields: [orderItemId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  spu          ProductSPU   @relation(fields: [spuId], references: [id])
  sku          ProductSKU   @relation(fields: [skuId], references: [id])
  helpfulVotes ReviewHelpful[]
  trialApplication TrialApplication[]

  @@index([spuId])
  @@index([userId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model ReviewHelpful {
  id        String   @id @default(uuid())
  reviewId  String
  userId    String
  isHelpful Boolean
  createdAt DateTime @default(now())

  review    ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
}

model Topic {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  description   String?
  coverImage    String?
  icon          String?
  category      String
  postCount     Int      @default(0)
  followerCount Int      @default(0)
  isHot         Boolean  @default(false)
  isOfficial    Boolean  @default(false)
  sortOrder     Int      @default(0)
  status        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  followers     TopicFollower[]
  posts         Post[]             @relation("PostTopics")

  @@index([category])
  @@index([status])
}

model TopicFollower {
  id        String   @id @default(uuid())
  topicId   String
  userId    String
  createdAt DateTime @default(now())

  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([topicId, userId])
}

model Post {
  id          String              @id @default(uuid())
  userId      String
  type        PostType
  title       String?
  content     String
  images      String[]
  videos      String[]
  gifs        String[]
  tags        String[]
  status      PostStatus          @default(PENDING_REVIEW)
  auditStatus ContentAuditStatus  @default(PENDING)
  auditReason String?
  viewCount   Int                 @default(0)
  likeCount   Int                 @default(0)
  commentCount Int                @default(0)
  shareCount  Int                 @default(0)
  isTop       Boolean             @default(false)
  isHot       Boolean             @default(false)
  isEssence   Boolean             @default(false)
  location    String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user        User                @relation(fields: [userId], references: [id])
  topics      Topic[]             @relation("PostTopics")
  comments    Comment[]
  likes       Like[]
  shares      Share[]
  auditLogs   ContentAuditLog[]   @relation("PostAuditLogs")
  adoption    AdoptionPost?

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([auditStatus])
  @@index([createdAt(sort: Desc)])
  @@index([likeCount(sort: Desc)])
}

model Comment {
  id           String   @id @default(uuid())
  postId       String
  userId       String
  parentId     String?
  replyToUserId String?
  content      String
  images       String[]
  status       String   @default("normal")
  likeCount    Int      @default(0)
  isAudited    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  post         Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id])
  parent       Comment? @relation("CommentThread", fields: [parentId], references: [id])
  children     Comment[] @relation("CommentThread")
  likes        Like[]

  @@index([postId])
  @@index([userId])
  @@index([parentId])
  @@index([createdAt(sort: Desc)])
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  targetId  String
  targetType String
  postId    String?
  commentId String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, targetId, targetType])
  @@index([userId])
  @@index([postId])
  @@index([commentId])
}

model Share {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  platform  String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([postId])
}

model DoctorProfile {
  id                String       @id @default(uuid())
  userId            String       @unique
  realName          String
  avatar            String?
  title             String
  department        String
  hospital          String
  yearsOfExperience Int
  specialties       String[]
  education         Json
  certificates      String[]
  licenseNumber     String
  licenseImage      String
  introduction      String
  consultationFee   Decimal      @db.Decimal(12, 2)
  consultationCount Int          @default(0)
  rating            Decimal      @default(0) @db.Decimal(3, 2)
  reviewCount       Int          @default(0)
  status            DoctorStatus @default(PENDING_VERIFICATION)
  isOnline          Boolean      @default(false)
  lastOnlineAt      DateTime?
  verifiedAt        DateTime?
  rejectReason      String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  consultations     ConsultationOrder[]
  auditLogs         ContentAuditLog[] @relation("DoctorAuditLogs")

  @@index([status])
  @@index([specialties])
  @@index([rating(sort: Desc)])
}

model ConsultationOrder {
  id             String              @id @default(uuid())
  orderNo        String              @unique
  userId         String
  doctorId       String
  petId          String?
  type           String
  title          String
  description    String
  images         String[]
  fee            Decimal             @db.Decimal(12, 2)
  status         ConsultationStatus  @default(PENDING)
  paymentStatus  PaymentStatus       @default(PENDING)
  paidAt         DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  cancelReason   String?
  rating         Int?
  reviewContent  String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  user           User                @relation(fields: [userId], references: [id])
  doctor         DoctorProfile       @relation(fields: [doctorId], references: [id])
  pet            PetProfile?         @relation(fields: [petId], references: [id])
  messages       ConsultationMessage[]
  records        ConsultationRecord[]

  @@index([userId])
  @@index([doctorId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model ConsultationMessage {
  id             String   @id @default(uuid())
  consultationId String
  senderId       String
  senderRole     String
  type           String
  content        String
  duration       Int?
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  consultation   ConsultationOrder @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId])
  @@index([createdAt(sort: Asc)])
}

model ConsultationRecord {
  id             String   @id @default(uuid())
  consultationId String
  doctorId       String
  diagnosis      String
  prescription   String?
  suggestions    String?
  followUpDate   DateTime?
  attachments    String[]
  createdAt      DateTime @default(now())

  consultation   ConsultationOrder @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId])
}

model AdoptionPost {
  id                String         @id @default(uuid())
  postId            String         @unique
  userId            String
  petType           PetType
  petName           String
  petAge            Decimal?       @db.Decimal(4, 1)
  petGender         PetGender      @default(UNKNOWN)
  breed             String?
  vaccinated        Boolean        @default(false)
  neutered          Boolean        @default(false)
  healthCondition   String
  location          String
  adoptionType      String
  adoptionFee       Decimal?       @db.Decimal(12, 2)
  requirements      String[]
  contactInfo       String
  status            AdoptionStatus @default(OPEN)
  applicantCount    Int            @default(0)
  approvedApplicantId String?
  closedAt          DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  post              Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  user              User           @relation(fields: [userId], references: [id])
  applications      AdoptionApplication[]

  @@index([userId])
  @@index([petType])
  @@index([status])
  @@index([location])
}

model AdoptionApplication {
  id              String   @id @default(uuid())
  adoptionPostId  String
  userId          String
  experience      String
  livingCondition String
  familyMembers   Int
  hasOtherPets    Boolean
  otherPetsInfo   String?
  monthlyBudget   Decimal  @db.Decimal(12, 2)
  reason          String
  contactInfo     String
  status          String   @default("pending")
  reviewedAt      DateTime?
  reviewerId      String?
  reviewReason    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  adoptionPost    AdoptionPost @relation(fields: [adoptionPostId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id])

  @@index([adoptionPostId])
  @@index([userId])
  @@index([status])
}

model UserRelationship {
  id          String           @id @default(uuid())
  followerId  String
  followingId String
  type        RelationshipType @default(FOLLOW)
  remark      String?
  createdAt   DateTime         @default(now())

  follower    User             @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User             @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Activity {
  id         String       @id @default(uuid())
  userId     String
  type       ActivityType
  targetType String
  targetId   String?
  content    String
  isRead     Boolean      @default(false)
  createdAt  DateTime     @default(now())

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt(sort: Desc)])
}

model ActivityEvent {
  id                  String                @id @default(uuid())
  title               String
  description         String
  coverImage          String?
  type                String
  startTime           DateTime
  endTime             DateTime
  participationCount  Int                   @default(0)
  maxParticipants     Int?
  prizes              Json
  rules               String[]
  isHot               Boolean               @default(false)
  status              String                @default("draft")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  participations      ActivityParticipation[]

  @@index([type])
  @@index([status])
  @@index([startTime, endTime])
}

model ActivityParticipation {
  id                 String                       @id @default(uuid())
  activityId         String
  userId             String
  status             ActivityParticipationStatus  @default(PARTICIPATED)
  participatedAt     DateTime                     @default(now())
  prizeId            String?
  wonAt              DateTime?
  shippingInfo       Json?
  trackingNo         String?
  trackingCompany    String?
  prizeSentAt        DateTime?
  prizeReceivedAt    DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  activity           ActivityEvent                @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user               User                         @relation(fields: [userId], references: [id])

  @@unique([activityId, userId])
  @@index([activityId])
  @@index([userId])
}

model Merchant {
  id                   String         @id @default(uuid())
  userId               String         @unique
  name                 String
  businessLicense      String
  businessLicenseImage String
  legalPersonName      String
  legalPersonIdCard    String
  legalPersonIdCardImage String
  contactName          String
  contactPhone         String
  contactEmail         String
  category             String[]
  brandName            String?
  logo                 String?
  description          String?
  address              String?
  status               MerchantStatus @default(PENDING)
  verifiedAt           DateTime?
  rejectReason         String?
  rating               Decimal        @default(0) @db.Decimal(3, 2)
  salesCount           Int            @default(0)
  reviewCount          Int            @default(0)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  products             ProductSPU[]
  orders               Order[]
  auditLogs            ContentAuditLog[] @relation("MerchantAuditLogs")

  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model ContentAuditLog {
  id              String              @id @default(uuid())
  contentId       String
  contentType     String
  auditorId       String?
  status          ContentAuditStatus
  reason          String?
  operation       String
  autoAuditResult Json?
  createdAt       DateTime            @default(now())

  postId          String?
  merchantId      String?
  doctorId        String?
  post            Post?               @relation("PostAuditLogs", fields: [postId], references: [id])
  merchant        Merchant?           @relation("MerchantAuditLogs", fields: [merchantId], references: [id])
  doctor          DoctorProfile?      @relation("DoctorAuditLogs", fields: [doctorId], references: [id])

  @@index([contentId, contentType])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([postId])
  @@index([merchantId])
  @@index([doctorId])
}

model UserBehaviorLog {
  id         String   @id @default(uuid())
  userId     String?
  anonymousId String
  eventType  String
  eventName  String
  properties Json
  pageUrl    String
  pageTitle  String
  referrer   String?
  userAgent  String
  ip         String?
  location   String?
  deviceType String
  os         String
  browser    String
  sessionId  String
  duration   Int?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([anonymousId])
  @@index([eventType])
  @@index([sessionId])
  @@index([createdAt(sort: Desc)])
}

model UserProfileTag {
  id           String   @id @default(uuid())
  userId       String
  tagCategory  String
  tagName      String
  tagValue     String?
  weight       Int      @default(50)
  source       String   @default("auto")
  lastUpdatedAt DateTime @default(now())
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tagCategory, tagName])
  @@index([userId])
  @@index([tagCategory])
}

model PetProfileTag {
  id           String   @id @default(uuid())
  petId        String
  tagCategory  String
  tagName      String
  tagValue     String?
  weight       Int      @default(50)
  source       String   @default("auto")
  lastUpdatedAt DateTime @default(now())
  createdAt    DateTime @default(now())

  pet          PetProfile @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@unique([petId, tagCategory, tagName])
  @@index([petId])
  @@index([tagCategory])
}

model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  type      String   @default("string")
  group     String   @default("default")
  isPublic  Boolean  @default(false)
  remark    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([group])
}
